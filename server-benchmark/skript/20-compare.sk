# Compare the existing id-only workload with a literal multi-row SQL statement.
# The table has six columns, but the other five are NULL in both paths. Building
# SQL, checking results and counting rows are outside the timed windows.
function benchCompareCase(raw: boolean, base: number):
    set {bench::case::busy} to true
    delete {bench::batch::*}
    delete {bench::rows::*}
    if {_raw} is true:
        set {_prefix} to "raw"
        set {_id} to {_base} + 1
        set {_sql} to "INSERT INTO orm_bench_compare (id) VALUES (%{_id}%)"
        loop 4999 times:
            set {_id} to {_base} + loop-number + 1
            set {_sql} to "%{_sql}%,(%{_id}%)"
    else:
        set {_prefix} to "plugin"
        loop 5000 times:
            set {bench::batch::%loop-number%::id} to {_base} + loop-number

    wait 1 tick
    benchBegin()
    if {_raw} is true:
        in connection "bench":
            execute update {_sql} and store affected rows in {_affected}
    else:
        in connection "bench":
            insert many {bench::batch::*} into table "orm_bench_compare" and store affected rows in {_affected} and wait
    benchEnd()
    set {_writeError} to last database error
    wait 1 tick
    set {bench::tick::watch} to false
    if {_writeError} is set:
        benchFailure("compare %{_prefix}% write: %{_writeError}%")
    if {_affected} is not 5000:
        benchFailure("compare %{_prefix}% write affected %{_affected}% rows")
    if {bench::backend} = "MongoDB":
        in connection "bench":
            execute command "{ ""count"": ""orm_bench_compare"" }" and store the result in {_count::*}
        set {_total} to {_count::n}
    else:
        in connection "bench":
            execute query "SELECT COUNT(*) AS total FROM orm_bench_compare" and store the result in {_count::*}
        set {_total} to {_count::1::total}
    if last database error is set:
        benchFailure("compare count: %last database error%")
    log "SKRIPTORM_BENCH=COMPARE %{_prefix}%write: rows=5000 ticks=%{bench::elapsed::ticks}% wallNs=%{bench::elapsed::ns}% gapNs=%{bench::tick::gap::max::ns}% affected=%{_affected}% total=%{_total}%"

    wait 1 tick
    benchBegin()
    if {_raw} is true:
        in connection "bench":
            execute query "SELECT id, pad1, pad2, pad3, pad4, pad5 FROM orm_bench_compare WHERE id > %{_base}%" and store the result in {bench::rows::*}
    else:
        in connection "bench":
            select many entities from table "orm_bench_compare" and store the results in {bench::rows::*}:
                where all:
                    id > {_base}
    benchEnd()
    set {_readError} to last database error
    wait 1 tick
    set {bench::tick::watch} to false
    set {_stored} to 0
    loop 5000 times:
        if {bench::rows::%loop-number%::id} is set:
            add 1 to {_stored}
        if {bench::rows::%loop-number%::pad1} is set:
            benchFailure("compare read did not preserve NULL")
    if {_stored} is not 5000:
        benchFailure("compare %{_prefix}% read stored %{_stored}% rows")
    if {_readError} is set:
        benchFailure("compare %{_prefix}% read: %{_readError}%")
    log "SKRIPTORM_BENCH=COMPARE %{_prefix}%read: rows=5000 ticks=%{bench::elapsed::ticks}% wallNs=%{bench::elapsed::ns}% gapNs=%{bench::tick::gap::max::ns}% stored=%{_stored}% error=%{_readError}%"
    delete {bench::batch::*}
    delete {bench::rows::*}
    set {bench::case::busy} to false

every 5 seconds:
    if {bench::done::curve} is not set:
        stop trigger
    if {bench::started::compare} is set:
        stop trigger
    set {bench::started::compare} to true
    in connection "bench":
        register a database table "orm_bench_compare":
            id: bigint, primary key, not null
            pad1: int, nullable
            pad2: int, nullable
            pad3: int, nullable
            pad4: int, nullable
            pad5: int, nullable
    if last database error is set:
        benchFailure("compare register table: %last database error%")
        stop trigger
    benchCompareCase(false, 100000)
    while {bench::case::busy} is true:
        wait 1 tick
    if {bench::backend} = "MongoDB":
        log "SKRIPTORM_BENCH=SKIP compare raw SQL: MongoDB does not execute SQL statements"
    else:
        benchCompareCase(true, 200000)
        while {bench::case::busy} is true:
            wait 1 tick
    set {bench::done::compare} to true

# The mapping layer, against the raw statement a script would write by hand.
#
# This answers one honest question about the "5000 rows" number: what the plugin's own path costs, on
# the same server, driver and rows, against a hand-written statement that does the same work. It is NOT
# a pure mapping-layer number, and the reason is written here rather than hidden:
#
#   * write: the plugin's `insert many` is a JDBC batch — one prepared single-row INSERT, one addBatch()
#     per row, one executeLargeBatch() (JdbcInsertMany.kt) — while the raw form here is one multi-row
#     INSERT with the values written in. The raw statement therefore binds nothing, so the write delta is
#     the plugin's mapping plus binding against a hand-optimal INSERT, not the mapping alone.
#
#   * read: both paths send the same SELECT over the same six columns. The plugin builds the column list
#     from the table declaration and converts the values on the way back; the raw form has the script
#     write the column list and returns values unconverted. That delta is close to the mapping layer, but
#     it still includes the conversion.
#
# The script waits for the curve to finish so every statement here runs warm, and it reports under a
# SKRIPTORM_BENCH=COMPARE prefix that the report does not parse, so the curve's own accounting is left
# untouched.

every 5 seconds:
    if {bench::done::compare} is set:
        stop trigger
    if {bench::done::curve} is not set:
        stop trigger
    if {bench::started::compare} is set:
        stop trigger
    set {bench::started::compare} to true

    # A second table on the same connection, same six-column shape as the probe, so the two paths write
    # and read the same rows and nothing here touches the curve's cumulative count.
    in connection "bench":
        register a database table "orm_bench_compare":
            id: bigint, primary key, not null
            pad1: int, nullable
            pad2: int, nullable
            pad3: int, nullable
            pad4: int, nullable
            pad5: int, nullable
    if last database error is set:
        log "SKRIPTORM_BENCH=FAIL compare register table: %last database error%"

    # Plugin write: 5000 rows, one column filled, exactly the shape the curve measures.
    delete {bench::batch::*}
    loop 5000 times:
        set {bench::batch::%loop-number%::id} to 100000 + loop-number

    set {bench::tick::before} to {bench::tick}
    delete {bench::tick::gap::max}
    set {bench::tick::watch} to true
    set {bench::before} to now
    in connection "bench":
        insert many {bench::batch::*} into table "orm_bench_compare" and store affected rows in {_affected} and wait
    set {bench::tick::watch} to false
    if last database error is set:
        log "SKRIPTORM_BENCH=FAIL compare plugin write: %last database error%"
    in connection "bench":
        execute query "SELECT COUNT(*) AS total FROM orm_bench_compare" and store the result in {bench::compare::count::*}
    log "SKRIPTORM_BENCH=COMPARE pluginwrite: rows=5000 ticks=%{bench::tick} - {bench::tick::before}% ms=[%difference between {bench::before} and now%] gap=[%{bench::tick::gap::max}%] affected=%{_affected}% total=%{bench::compare::count::1::total}%"

    # Plugin read: the same 5000 rows it just wrote.
    delete {bench::rows::*}
    set {bench::tick::before} to {bench::tick}
    delete {bench::tick::gap::max}
    set {bench::tick::watch} to true
    set {bench::before} to now
    in connection "bench":
        select many entities from table "orm_bench_compare" and store the results in {bench::rows::*}:
            where all:
                id > 100000
    set {bench::tick::watch} to false
    set {bench::stored} to 0
    loop 5000 times:
        if {bench::rows::%loop-number%::id} is set:
            add 1 to {bench::stored}
    log "SKRIPTORM_BENCH=COMPARE pluginread: rows=5000 ticks=%{bench::tick} - {bench::tick::before}% ms=[%difference between {bench::before} and now%] gap=[%{bench::tick::gap::max}%] stored=%{bench::stored}% error=%last database error%"
    delete {bench::rows::*}

    # Raw write: the same 5000 rows, one multi-row INSERT with the values written in. The statement is
    # built outside the timed window, so the string building is not what gets measured.
    set {_id} to 200001
    set {_sql} to "INSERT INTO orm_bench_compare (id) VALUES (%{_id}%)"
    loop 4999 times:
        set {_id} to {_id} + 1
        set {_sql} to "%{_sql}%,(%{_id}%)"

    set {bench::tick::before} to {bench::tick}
    delete {bench::tick::gap::max}
    set {bench::tick::watch} to true
    set {bench::before} to now
    in connection "bench":
        execute update {_sql} and store affected rows in {_affected}
    set {bench::tick::watch} to false
    if last database error is set:
        log "SKRIPTORM_BENCH=FAIL compare raw write: %last database error%"
    in connection "bench":
        execute query "SELECT COUNT(*) AS total FROM orm_bench_compare" and store the result in {bench::compare::count::*}
    log "SKRIPTORM_BENCH=COMPARE rawwrite: rows=5000 ticks=%{bench::tick} - {bench::tick::before}% ms=[%difference between {bench::before} and now%] gap=[%{bench::tick::gap::max}%] affected=%{_affected}% total=%{bench::compare::count::1::total}%"

    # Raw read: the same 5000 rows, same SELECT over the same six columns.
    delete {bench::rows::*}
    set {bench::tick::before} to {bench::tick}
    delete {bench::tick::gap::max}
    set {bench::tick::watch} to true
    set {bench::before} to now
    in connection "bench":
        execute query "SELECT id, pad1, pad2, pad3, pad4, pad5 FROM orm_bench_compare WHERE id > 200000" and store the result in {bench::rows::*}
    set {bench::tick::watch} to false
    set {bench::stored} to 0
    loop 5000 times:
        if {bench::rows::%loop-number%::id} is set:
            add 1 to {bench::stored}
    log "SKRIPTORM_BENCH=COMPARE rawread: rows=5000 ticks=%{bench::tick} - {bench::tick::before}% ms=[%difference between {bench::before} and now%] gap=[%{bench::tick::gap::max}%] stored=%{bench::stored}% error=%last database error%"
    delete {bench::rows::*}

    set {bench::done::compare} to true

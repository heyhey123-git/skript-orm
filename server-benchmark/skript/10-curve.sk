import:
    java.lang.System

# Measure one write and one read at each row count on a live Paper server.
# System.nanoTime() brackets only the statement; validation queries and row counts
# run afterward. The tick observer records the longest interval between tick starts
# while the statement runs. That interval can reveal overruns but cannot measure
# work that fits within a tick or assign an overrun to this statement alone.
# The six-column table crosses the 30,000-value write boundary at 5,000 rows.
# Literal loop counts keep Skript loop-number references unambiguous.
# Key ranges avoid depending on the dialect's unsupported delete operation.
# The SQLite URL uses pragmas to reduce disk sync costs for the local workload.

every 5 seconds:
    # The guards come first and contain nothing but the stop, which is how every script in `server-test`
    # keeps itself to one run.
    if {bench::done::curve} is set:
        stop trigger
    if {bench::started::curve} is set:
        stop trigger
    set {bench::started::curve} to true

    # The plugin and Skript are loaded before any of this runs, so this is only long enough for the tick
    # counter to have something in it.
    wait 5 seconds

    set {bench::backend} to "__BENCH_TYPE__"
    if {bench::backend} = "JDBC":
        create a connection named "bench" to database "JDBC" with properties:
            driver: "org.sqlite.JDBC"
            url: "__BENCH_URL__"
    else if {bench::backend} = "MongoDB":
        create a connection named "bench" to database "MongoDB" with properties:
            url: "__BENCH_URL__"
            database: "skriptorm_benchmark"
    else:
        create a connection named "bench" to database "__BENCH_TYPE__" with properties:
            url: "__BENCH_URL__"
            username: "__BENCH_USERNAME__"
            password: "__BENCH_PASSWORD__"
    if last database error is set:
        log "SKRIPTORM_BENCH=FAIL curve connect: %last database error%"

    in connection "bench":
        register a database table "orm_bench_probe":
            id: bigint, primary key, not null
            pad1: int, nullable
            pad2: int, nullable
            pad3: int, nullable
            pad4: int, nullable
            pad5: int, nullable
    if last database error is set:
        log "SKRIPTORM_BENCH=FAIL curve register table: %last database error%"

    # The key ranges are handed out rather than reset, because nothing here deletes.
    set {bench::base} to 0

    # 100 rows, which is one statement well inside every budget.
    add 100000 to {bench::base}
    delete {bench::batch::*}
    loop 100 times:
        set {bench::batch::%loop-number%::id} to {bench::base} + loop-number
    log "SKRIPTORM_BENCH=DIAG first batch first row is [%{bench::batch::1::id}%] of range above %{bench::base}%"

    set {bench::tick::before} to {bench::tick}
    delete {bench::tick::gap::max::ns}
    set {bench::tick::watch} to true
    set {bench::before} to System.nanoTime()
    in connection "bench":
        insert many {bench::batch::*} into table "orm_bench_probe" and store affected rows in {_affected} and wait
    set {bench::elapsed::ns} to System.nanoTime() - {bench::before}
    set {bench::elapsed::ticks} to {bench::tick} - {bench::tick::before}
    wait 1 tick
    set {bench::tick::watch} to false
    if last database error is set:
        log "SKRIPTORM_BENCH=FAIL curve write 100: %last database error%"
    delete {bench::count::*}
    if {bench::backend} = "MongoDB":
        in connection "bench":
            execute command "{ ""count"": ""orm_bench_probe"" }" and store the result in {bench::count::*}
        set {bench::count::1::total} to {bench::count::n}
    else:
        in connection "bench":
            execute query "SELECT COUNT(*) AS total FROM orm_bench_probe" and store the result in {bench::count::*}
    if last database error is set:
        log "SKRIPTORM_BENCH=FAIL curve count: %last database error%"
    log "SKRIPTORM_BENCH write: rows=100 ticks=%{bench::elapsed::ticks}% wallNs=%{bench::elapsed::ns}% gapNs=%{bench::tick::gap::max::ns}% affected=%{_affected}% total=%{bench::count::1::total}%"

    delete {bench::rows::*}
    set {bench::tick::before} to {bench::tick}
    delete {bench::tick::gap::max::ns}
    set {bench::tick::watch} to true
    set {bench::before} to System.nanoTime()
    in connection "bench":
        select many entities from table "orm_bench_probe" and store the results in {bench::rows::*}:
            where all:
                id > {bench::base}
    set {bench::elapsed::ns} to System.nanoTime() - {bench::before}
    set {bench::elapsed::ticks} to {bench::tick} - {bench::tick::before}
    wait 1 tick
    set {bench::tick::watch} to false
    set {bench::stored} to 0
    loop 100 times:
        if {bench::rows::%loop-number%::id} is set:
            add 1 to {bench::stored}
    log "SKRIPTORM_BENCH read: rows=100 ticks=%{bench::elapsed::ticks}% wallNs=%{bench::elapsed::ns}% gapNs=%{bench::tick::gap::max::ns}% stored=%{bench::stored}% total=%{bench::count::1::total}% error=%last database error%"
    delete {bench::rows::*}

    # 500 rows.
    add 100000 to {bench::base}
    delete {bench::batch::*}
    loop 500 times:
        set {bench::batch::%loop-number%::id} to {bench::base} + loop-number

    set {bench::tick::before} to {bench::tick}
    delete {bench::tick::gap::max::ns}
    set {bench::tick::watch} to true
    set {bench::before} to System.nanoTime()
    in connection "bench":
        insert many {bench::batch::*} into table "orm_bench_probe" and store affected rows in {_affected} and wait
    set {bench::elapsed::ns} to System.nanoTime() - {bench::before}
    set {bench::elapsed::ticks} to {bench::tick} - {bench::tick::before}
    wait 1 tick
    set {bench::tick::watch} to false
    if last database error is set:
        log "SKRIPTORM_BENCH=FAIL curve write 500: %last database error%"
    delete {bench::count::*}
    if {bench::backend} = "MongoDB":
        in connection "bench":
            execute command "{ ""count"": ""orm_bench_probe"" }" and store the result in {bench::count::*}
        set {bench::count::1::total} to {bench::count::n}
    else:
        in connection "bench":
            execute query "SELECT COUNT(*) AS total FROM orm_bench_probe" and store the result in {bench::count::*}
    if last database error is set:
        log "SKRIPTORM_BENCH=FAIL curve count: %last database error%"
    log "SKRIPTORM_BENCH write: rows=500 ticks=%{bench::elapsed::ticks}% wallNs=%{bench::elapsed::ns}% gapNs=%{bench::tick::gap::max::ns}% affected=%{_affected}% total=%{bench::count::1::total}%"

    delete {bench::rows::*}
    set {bench::tick::before} to {bench::tick}
    delete {bench::tick::gap::max::ns}
    set {bench::tick::watch} to true
    set {bench::before} to System.nanoTime()
    in connection "bench":
        select many entities from table "orm_bench_probe" and store the results in {bench::rows::*}:
            where all:
                id > {bench::base}
    set {bench::elapsed::ns} to System.nanoTime() - {bench::before}
    set {bench::elapsed::ticks} to {bench::tick} - {bench::tick::before}
    wait 1 tick
    set {bench::tick::watch} to false
    set {bench::stored} to 0
    loop 500 times:
        if {bench::rows::%loop-number%::id} is set:
            add 1 to {bench::stored}
    log "SKRIPTORM_BENCH read: rows=500 ticks=%{bench::elapsed::ticks}% wallNs=%{bench::elapsed::ns}% gapNs=%{bench::tick::gap::max::ns}% stored=%{bench::stored}% total=%{bench::count::1::total}% error=%last database error%"
    delete {bench::rows::*}

    # 1000 rows.
    add 100000 to {bench::base}
    delete {bench::batch::*}
    loop 1000 times:
        set {bench::batch::%loop-number%::id} to {bench::base} + loop-number

    set {bench::tick::before} to {bench::tick}
    delete {bench::tick::gap::max::ns}
    set {bench::tick::watch} to true
    set {bench::before} to System.nanoTime()
    in connection "bench":
        insert many {bench::batch::*} into table "orm_bench_probe" and store affected rows in {_affected} and wait
    set {bench::elapsed::ns} to System.nanoTime() - {bench::before}
    set {bench::elapsed::ticks} to {bench::tick} - {bench::tick::before}
    wait 1 tick
    set {bench::tick::watch} to false
    if last database error is set:
        log "SKRIPTORM_BENCH=FAIL curve write 1000: %last database error%"
    delete {bench::count::*}
    if {bench::backend} = "MongoDB":
        in connection "bench":
            execute command "{ ""count"": ""orm_bench_probe"" }" and store the result in {bench::count::*}
        set {bench::count::1::total} to {bench::count::n}
    else:
        in connection "bench":
            execute query "SELECT COUNT(*) AS total FROM orm_bench_probe" and store the result in {bench::count::*}
    if last database error is set:
        log "SKRIPTORM_BENCH=FAIL curve count: %last database error%"
    log "SKRIPTORM_BENCH write: rows=1000 ticks=%{bench::elapsed::ticks}% wallNs=%{bench::elapsed::ns}% gapNs=%{bench::tick::gap::max::ns}% affected=%{_affected}% total=%{bench::count::1::total}%"

    delete {bench::rows::*}
    set {bench::tick::before} to {bench::tick}
    delete {bench::tick::gap::max::ns}
    set {bench::tick::watch} to true
    set {bench::before} to System.nanoTime()
    in connection "bench":
        select many entities from table "orm_bench_probe" and store the results in {bench::rows::*}:
            where all:
                id > {bench::base}
    set {bench::elapsed::ns} to System.nanoTime() - {bench::before}
    set {bench::elapsed::ticks} to {bench::tick} - {bench::tick::before}
    wait 1 tick
    set {bench::tick::watch} to false
    set {bench::stored} to 0
    loop 1000 times:
        if {bench::rows::%loop-number%::id} is set:
            add 1 to {bench::stored}
    log "SKRIPTORM_BENCH read: rows=1000 ticks=%{bench::elapsed::ticks}% wallNs=%{bench::elapsed::ns}% gapNs=%{bench::tick::gap::max::ns}% stored=%{bench::stored}% total=%{bench::count::1::total}% error=%last database error%"
    delete {bench::rows::*}

    # 2500 rows.
    add 100000 to {bench::base}
    delete {bench::batch::*}
    loop 2500 times:
        set {bench::batch::%loop-number%::id} to {bench::base} + loop-number

    set {bench::tick::before} to {bench::tick}
    delete {bench::tick::gap::max::ns}
    set {bench::tick::watch} to true
    set {bench::before} to System.nanoTime()
    in connection "bench":
        insert many {bench::batch::*} into table "orm_bench_probe" and store affected rows in {_affected} and wait
    set {bench::elapsed::ns} to System.nanoTime() - {bench::before}
    set {bench::elapsed::ticks} to {bench::tick} - {bench::tick::before}
    wait 1 tick
    set {bench::tick::watch} to false
    if last database error is set:
        log "SKRIPTORM_BENCH=FAIL curve write 2500: %last database error%"
    delete {bench::count::*}
    if {bench::backend} = "MongoDB":
        in connection "bench":
            execute command "{ ""count"": ""orm_bench_probe"" }" and store the result in {bench::count::*}
        set {bench::count::1::total} to {bench::count::n}
    else:
        in connection "bench":
            execute query "SELECT COUNT(*) AS total FROM orm_bench_probe" and store the result in {bench::count::*}
    if last database error is set:
        log "SKRIPTORM_BENCH=FAIL curve count: %last database error%"
    log "SKRIPTORM_BENCH write: rows=2500 ticks=%{bench::elapsed::ticks}% wallNs=%{bench::elapsed::ns}% gapNs=%{bench::tick::gap::max::ns}% affected=%{_affected}% total=%{bench::count::1::total}%"

    delete {bench::rows::*}
    set {bench::tick::before} to {bench::tick}
    delete {bench::tick::gap::max::ns}
    set {bench::tick::watch} to true
    set {bench::before} to System.nanoTime()
    in connection "bench":
        select many entities from table "orm_bench_probe" and store the results in {bench::rows::*}:
            where all:
                id > {bench::base}
    set {bench::elapsed::ns} to System.nanoTime() - {bench::before}
    set {bench::elapsed::ticks} to {bench::tick} - {bench::tick::before}
    wait 1 tick
    set {bench::tick::watch} to false
    set {bench::stored} to 0
    loop 2500 times:
        if {bench::rows::%loop-number%::id} is set:
            add 1 to {bench::stored}
    log "SKRIPTORM_BENCH read: rows=2500 ticks=%{bench::elapsed::ticks}% wallNs=%{bench::elapsed::ns}% gapNs=%{bench::tick::gap::max::ns}% stored=%{bench::stored}% total=%{bench::count::1::total}% error=%last database error%"
    delete {bench::rows::*}

    # 5000 rows: the write budget in one statement, and the read ceiling exactly reached.
    add 100000 to {bench::base}
    delete {bench::batch::*}
    loop 5000 times:
        set {bench::batch::%loop-number%::id} to {bench::base} + loop-number

    set {bench::tick::before} to {bench::tick}
    delete {bench::tick::gap::max::ns}
    set {bench::tick::watch} to true
    set {bench::before} to System.nanoTime()
    in connection "bench":
        insert many {bench::batch::*} into table "orm_bench_probe" and store affected rows in {_affected} and wait
    set {bench::elapsed::ns} to System.nanoTime() - {bench::before}
    set {bench::elapsed::ticks} to {bench::tick} - {bench::tick::before}
    wait 1 tick
    set {bench::tick::watch} to false
    if last database error is set:
        log "SKRIPTORM_BENCH=FAIL curve write 5000: %last database error%"
    delete {bench::count::*}
    if {bench::backend} = "MongoDB":
        in connection "bench":
            execute command "{ ""count"": ""orm_bench_probe"" }" and store the result in {bench::count::*}
        set {bench::count::1::total} to {bench::count::n}
    else:
        in connection "bench":
            execute query "SELECT COUNT(*) AS total FROM orm_bench_probe" and store the result in {bench::count::*}
    if last database error is set:
        log "SKRIPTORM_BENCH=FAIL curve count: %last database error%"
    log "SKRIPTORM_BENCH write: rows=5000 ticks=%{bench::elapsed::ticks}% wallNs=%{bench::elapsed::ns}% gapNs=%{bench::tick::gap::max::ns}% affected=%{_affected}% total=%{bench::count::1::total}%"

    delete {bench::rows::*}
    set {bench::tick::before} to {bench::tick}
    delete {bench::tick::gap::max::ns}
    set {bench::tick::watch} to true
    set {bench::before} to System.nanoTime()
    in connection "bench":
        select many entities from table "orm_bench_probe" and store the results in {bench::rows::*}:
            where all:
                id > {bench::base}
    set {bench::elapsed::ns} to System.nanoTime() - {bench::before}
    set {bench::elapsed::ticks} to {bench::tick} - {bench::tick::before}
    wait 1 tick
    set {bench::tick::watch} to false
    set {bench::stored} to 0
    loop 5000 times:
        if {bench::rows::%loop-number%::id} is set:
            add 1 to {bench::stored}
    log "SKRIPTORM_BENCH read: rows=5000 ticks=%{bench::elapsed::ticks}% wallNs=%{bench::elapsed::ns}% gapNs=%{bench::tick::gap::max::ns}% stored=%{bench::stored}% total=%{bench::count::1::total}% error=%last database error%"
    delete {bench::rows::*}

    # 10000 rows: twice the write budget, so two statements, and twice the read ceiling, so a refusal that
    # is the ceiling being re-derived rather than restated.
    add 100000 to {bench::base}
    delete {bench::batch::*}
    loop 10000 times:
        set {bench::batch::%loop-number%::id} to {bench::base} + loop-number

    set {bench::tick::before} to {bench::tick}
    delete {bench::tick::gap::max::ns}
    set {bench::tick::watch} to true
    set {bench::before} to System.nanoTime()
    in connection "bench":
        insert many {bench::batch::*} into table "orm_bench_probe" and store affected rows in {_affected} and wait
    set {bench::elapsed::ns} to System.nanoTime() - {bench::before}
    set {bench::elapsed::ticks} to {bench::tick} - {bench::tick::before}
    wait 1 tick
    set {bench::tick::watch} to false
    if last database error is set:
        log "SKRIPTORM_BENCH=FAIL curve write 10000: %last database error%"
    delete {bench::count::*}
    if {bench::backend} = "MongoDB":
        in connection "bench":
            execute command "{ ""count"": ""orm_bench_probe"" }" and store the result in {bench::count::*}
        set {bench::count::1::total} to {bench::count::n}
    else:
        in connection "bench":
            execute query "SELECT COUNT(*) AS total FROM orm_bench_probe" and store the result in {bench::count::*}
    if last database error is set:
        log "SKRIPTORM_BENCH=FAIL curve count: %last database error%"
    log "SKRIPTORM_BENCH write: rows=10000 ticks=%{bench::elapsed::ticks}% wallNs=%{bench::elapsed::ns}% gapNs=%{bench::tick::gap::max::ns}% affected=%{_affected}% total=%{bench::count::1::total}%"

    delete {bench::rows::*}
    set {bench::tick::before} to {bench::tick}
    delete {bench::tick::gap::max::ns}
    set {bench::tick::watch} to true
    set {bench::before} to System.nanoTime()
    in connection "bench":
        select many entities from table "orm_bench_probe" and store the results in {bench::rows::*}:
            where all:
                id > {bench::base}
    set {bench::elapsed::ns} to System.nanoTime() - {bench::before}
    set {bench::elapsed::ticks} to {bench::tick} - {bench::tick::before}
    wait 1 tick
    set {bench::tick::watch} to false
    set {bench::stored} to 0
    loop 10000 times:
        if {bench::rows::%loop-number%::id} is set:
            add 1 to {bench::stored}
    log "SKRIPTORM_BENCH read: rows=10000 ticks=%{bench::elapsed::ticks}% wallNs=%{bench::elapsed::ns}% gapNs=%{bench::tick::gap::max::ns}% stored=%{bench::stored}% total=%{bench::count::1::total}% error=%last database error%"
    delete {bench::rows::*}

    # The idle window shows the tick observer's baseline. Counted spin loops
    # confirm that a long main-thread block appears in its longest gap.
    delete {bench::tick::gap::max::ns}
    set {bench::tick::watch} to true
    set {bench::tick::before} to {bench::tick}
    set {bench::before} to System.nanoTime()
    wait 6 seconds
    set {bench::elapsed::ns} to System.nanoTime() - {bench::before}
    set {bench::elapsed::ticks} to {bench::tick} - {bench::tick::before}
    wait 1 tick
    set {bench::tick::watch} to false
    log "SKRIPTORM_BENCH calibrate: label=idle6s ticks=%{bench::elapsed::ticks}% windowNs=%{bench::elapsed::ns}% gapNs=%{bench::tick::gap::max::ns}% spun=0"

    set {bench::tick::before} to {bench::tick}
    delete {bench::tick::gap::max::ns}
    set {bench::tick::watch} to true
    set {bench::spin::before} to System.nanoTime()
    set {bench::before} to {bench::spin::before}
    set {_spun} to 0
    loop 120000 times:
        set {_spun} to {_spun} + 1
    set {bench::spin::elapsed::ns} to System.nanoTime() - {bench::spin::before}
    wait 1 second
    set {bench::elapsed::ns} to System.nanoTime() - {bench::before}
    set {bench::elapsed::ticks} to {bench::tick} - {bench::tick::before}
    wait 1 tick
    set {bench::tick::watch} to false
    log "SKRIPTORM_BENCH calibrate: label=spin120000 ticks=%{bench::elapsed::ticks}% spinNs=%{bench::spin::elapsed::ns}% windowNs=%{bench::elapsed::ns}% gapNs=%{bench::tick::gap::max::ns}% spun=%{_spun}%"

    set {bench::tick::before} to {bench::tick}
    delete {bench::tick::gap::max::ns}
    set {bench::tick::watch} to true
    set {bench::spin::before} to System.nanoTime()
    set {bench::before} to {bench::spin::before}
    set {_spun} to 0
    loop 180000 times:
        set {_spun} to {_spun} + 1
    set {bench::spin::elapsed::ns} to System.nanoTime() - {bench::spin::before}
    wait 1 second
    set {bench::elapsed::ns} to System.nanoTime() - {bench::before}
    set {bench::elapsed::ticks} to {bench::tick} - {bench::tick::before}
    wait 1 tick
    set {bench::tick::watch} to false
    log "SKRIPTORM_BENCH calibrate: label=spin180000 ticks=%{bench::elapsed::ticks}% spinNs=%{bench::spin::elapsed::ns}% windowNs=%{bench::elapsed::ns}% gapNs=%{bench::tick::gap::max::ns}% spun=%{_spun}%"

    set {bench::tick::before} to {bench::tick}
    delete {bench::tick::gap::max::ns}
    set {bench::tick::watch} to true
    set {bench::spin::before} to System.nanoTime()
    set {bench::before} to {bench::spin::before}
    set {_spun} to 0
    loop 300000 times:
        set {_spun} to {_spun} + 1
    set {bench::spin::elapsed::ns} to System.nanoTime() - {bench::spin::before}
    wait 1 second
    set {bench::elapsed::ns} to System.nanoTime() - {bench::before}
    set {bench::elapsed::ticks} to {bench::tick} - {bench::tick::before}
    wait 1 tick
    set {bench::tick::watch} to false
    log "SKRIPTORM_BENCH calibrate: label=spin300000 ticks=%{bench::elapsed::ticks}% spinNs=%{bench::spin::elapsed::ns}% windowNs=%{bench::elapsed::ns}% gapNs=%{bench::tick::gap::max::ns}% spun=%{_spun}%"

    set {bench::tick::before} to {bench::tick}
    delete {bench::tick::gap::max::ns}
    set {bench::tick::watch} to true
    set {bench::spin::before} to System.nanoTime()
    set {bench::before} to {bench::spin::before}
    set {_spun} to 0
    loop 900000 times:
        set {_spun} to {_spun} + 1
    set {bench::spin::elapsed::ns} to System.nanoTime() - {bench::spin::before}
    wait 1 second
    set {bench::elapsed::ns} to System.nanoTime() - {bench::before}
    set {bench::elapsed::ticks} to {bench::tick} - {bench::tick::before}
    wait 1 tick
    set {bench::tick::watch} to false
    log "SKRIPTORM_BENCH calibrate: label=spin900000 ticks=%{bench::elapsed::ticks}% spinNs=%{bench::spin::elapsed::ns}% windowNs=%{bench::elapsed::ns}% gapNs=%{bench::tick::gap::max::ns}% spun=%{_spun}%"

    # Repeat the 5,000-row case after warmup; report it separately.
    add 100000 to {bench::base}
    delete {bench::batch::*}
    loop 5000 times:
        set {bench::batch::%loop-number%::id} to {bench::base} + loop-number

    set {bench::tick::before} to {bench::tick}
    delete {bench::tick::gap::max::ns}
    set {bench::tick::watch} to true
    set {bench::before} to System.nanoTime()
    in connection "bench":
        insert many {bench::batch::*} into table "orm_bench_probe" and store affected rows in {_affected} and wait
    set {bench::elapsed::ns} to System.nanoTime() - {bench::before}
    set {bench::elapsed::ticks} to {bench::tick} - {bench::tick::before}
    wait 1 tick
    set {bench::tick::watch} to false
    if last database error is set:
        log "SKRIPTORM_BENCH=FAIL curve warm write 5000: %last database error%"
    delete {bench::count::*}
    if {bench::backend} = "MongoDB":
        in connection "bench":
            execute command "{ ""count"": ""orm_bench_probe"" }" and store the result in {bench::count::*}
        set {bench::count::1::total} to {bench::count::n}
    else:
        in connection "bench":
            execute query "SELECT COUNT(*) AS total FROM orm_bench_probe" and store the result in {bench::count::*}
    if last database error is set:
        log "SKRIPTORM_BENCH=FAIL curve count: %last database error%"
    log "SKRIPTORM_BENCH warmwrite: rows=5000 ticks=%{bench::elapsed::ticks}% wallNs=%{bench::elapsed::ns}% gapNs=%{bench::tick::gap::max::ns}% affected=%{_affected}% total=%{bench::count::1::total}%"

    delete {bench::rows::*}
    set {bench::tick::before} to {bench::tick}
    delete {bench::tick::gap::max::ns}
    set {bench::tick::watch} to true
    set {bench::before} to System.nanoTime()
    in connection "bench":
        select many entities from table "orm_bench_probe" and store the results in {bench::rows::*}:
            where all:
                id > {bench::base}
    set {bench::elapsed::ns} to System.nanoTime() - {bench::before}
    set {bench::elapsed::ticks} to {bench::tick} - {bench::tick::before}
    wait 1 tick
    set {bench::tick::watch} to false
    set {bench::stored} to 0
    loop 5000 times:
        if {bench::rows::%loop-number%::id} is set:
            add 1 to {bench::stored}
    log "SKRIPTORM_BENCH warmread: rows=5000 ticks=%{bench::elapsed::ticks}% wallNs=%{bench::elapsed::ns}% gapNs=%{bench::tick::gap::max::ns}% stored=%{bench::stored}% total=%{bench::count::1::total}% error=%last database error%"
    delete {bench::rows::*}

    set {bench::done::curve} to true

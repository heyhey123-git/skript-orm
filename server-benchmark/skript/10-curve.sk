options:
    warmups: 3
    samples: 10

# Inputs, count queries, validation and cleanup are outside the timed windows.
# Each case gets a fresh key range and selects only that range. Local lists stay
# in this function's event through database waits; suites await its busy flag.
function benchRoundTrip(rows: number, table: text, workload: text, source: text, target: text, replaced: boolean, sample: number, legacy: text):
    set {bench::case::busy} to true
    add 100000 to {bench::base}
    set {_base} to {bench::base}
    set {_upper} to {_base} + {_rows}
    delete {bench::batch::*}
    delete {bench::rows::*}
    set {_item} to diamond sword
    if {_workload} = "objects":
        set name of {_item} to "Benchmark sword"
        set lore of {_item} to "Stored outside the timed window" and "Round-trip validation"
    set {_position} to location at 12, 64, -9 in world "world"
    loop {_rows} times:
        set {_row} to loop-number
        set {_batch::%{_row}%::id} to {_base} + {_row}
        if {_workload} is not "sparse":
            set {_batch::%{_row}%::pad1} to {_row}
            set {_batch::%{_row}%::pad2} to 0 - {_row}
            set {_batch::%{_row}%::pad3} to {_row} * 2
            if {_workload} = "primitive":
                set {_batch::%{_row}%::pad4} to {_row} * 3
                set {_batch::%{_row}%::pad5} to {_row} * 4
            else:
                set {_batch::%{_row}%::item} to {_item}
                set {_batch::%{_row}%::position} to {_position}
        if {_source} = "global":
            set {bench::batch::%{_row}%::id} to {_batch::%{_row}%::id}
            set {bench::batch::%{_row}%::pad1} to {_batch::%{_row}%::pad1}
            set {bench::batch::%{_row}%::pad2} to {_batch::%{_row}%::pad2}
            set {bench::batch::%{_row}%::pad3} to {_batch::%{_row}%::pad3}
            if {_workload} = "primitive":
                set {bench::batch::%{_row}%::pad4} to {_batch::%{_row}%::pad4}
                set {bench::batch::%{_row}%::pad5} to {_batch::%{_row}%::pad5}
            else if {_workload} is not "sparse":
                set {bench::batch::%{_row}%::item} to {_item}
                set {bench::batch::%{_row}%::position} to {_position}

    wait 1 tick
    benchBegin()
    if {_source} = "local":
        in connection "bench":
            insert many {_batch::*} into table {_table} and store affected rows in {_affected} and wait
    else:
        in connection "bench":
            insert many {bench::batch::*} into table {_table} and store affected rows in {_affected} and wait
    benchEnd()
    set {_writeError} to last database error
    wait 1 tick
    set {bench::tick::watch} to false
    if {_writeError} is set:
        benchFailure("%{_workload}% %{_source}% write %{_rows}%: %{_writeError}%")
    if {_affected} is not {_rows}:
        benchFailure("%{_workload}% write affected %{_affected}% rows; expected %{_rows}%")

    if {bench::backend} = "MongoDB":
        in connection "bench":
            execute command "{ ""count"": ""%{_table}%"" }" and store the result in {_count::*}
        set {_total} to {_count::n}
    else:
        in connection "bench":
            execute query "SELECT COUNT(*) AS total FROM %{_table}%" and store the result in {_count::*}
        set {_total} to {_count::1::total}
    if last database error is set:
        benchFailure("%{_table}% count: %last database error%")
    if {_legacy} is not "none":
        log "SKRIPTORM_BENCH %{_legacy}%write: rows=%{_rows}% ticks=%{bench::elapsed::ticks}% wallNs=%{bench::elapsed::ns}% gapNs=%{bench::tick::gap::max::ns}% affected=%{_affected}% total=%{_total}%"
    else:
        log "SKRIPTORM_BENCH=SAMPLE write: workload=%{_workload}% source=%{_source}% target=%{_target}% replaced=%{_replaced}% sample=%{_sample}% rows=%{_rows}% ticks=%{bench::elapsed::ticks}% wallNs=%{bench::elapsed::ns}% gapNs=%{bench::tick::gap::max::ns}% affected=%{_affected}% total=%{_total}% %{bench::phases}%"

    # Pre-fill at the query's width, plus a stale row and column, to check that
    # writing new results replaces the list rather than merging with old data.
    if {_replaced} is true:
        loop {_rows} times:
            set {_row} to loop-number
            if {_target} = "local":
                set {_result::%{_row}%::id} to -1
                set {_result::%{_row}%::pad1} to -1
                set {_result::%{_row}%::pad2} to -1
                set {_result::%{_row}%::pad3} to -1
                set {_result::%{_row}%::pad4} to -1
                set {_result::%{_row}%::pad5} to -1
            else:
                set {bench::rows::%{_row}%::id} to -1
                set {bench::rows::%{_row}%::pad1} to -1
                set {bench::rows::%{_row}%::pad2} to -1
                set {bench::rows::%{_row}%::pad3} to -1
                set {bench::rows::%{_row}%::pad4} to -1
                set {bench::rows::%{_row}%::pad5} to -1
        set {_extra} to {_rows} + 1
        if {_target} = "local":
            set {_result::%{_extra}%::id} to -1
            set {_result::1::stale} to true
        else:
            set {bench::rows::%{_extra}%::id} to -1
            set {bench::rows::1::stale} to true

    wait 1 tick
    benchBegin()
    if {_target} = "local":
        in connection "bench":
            select many entities from table {_table} and store the results in {_result::*}:
                where all:
                    id > {_base}
                    id <= {_upper}
    else:
        in connection "bench":
            select many entities from table {_table} and store the results in {bench::rows::*}:
                where all:
                    id > {_base}
                    id <= {_upper}
    benchEnd()
    set {_readError} to last database error
    wait 1 tick
    set {bench::tick::watch} to false

    set {_stored} to 0
    loop {_rows} times:
        set {_row} to loop-number
        if {_target} = "local":
            set {_id} to {_result::%{_row}%::id}
            set {_pad1} to {_result::%{_row}%::pad1}
            set {_pad5} to {_result::%{_row}%::pad5}
            set {_readItem} to {_result::%{_row}%::item}
            set {_readPosition} to {_result::%{_row}%::position}
        else:
            set {_id} to {bench::rows::%{_row}%::id}
            set {_pad1} to {bench::rows::%{_row}%::pad1}
            set {_pad5} to {bench::rows::%{_row}%::pad5}
            set {_readItem} to {bench::rows::%{_row}%::item}
            set {_readPosition} to {bench::rows::%{_row}%::position}
        if {_id} is set:
            add 1 to {_stored}
            set {_originalRow} to {_id} - {_base}
            if {_workload} = "primitive":
                if {_pad1} is not {_originalRow}:
                    benchFailure("primitive read returned wrong pad1 for id %{_id}%")
                if {_pad5} is not {_originalRow} * 4:
                    benchFailure("primitive read returned wrong pad5 for id %{_id}%")
            else if {_workload} is not "sparse":
                if type of {_readItem} is not diamond sword:
                    benchFailure("object read returned wrong item for id %{_id}%")
                if x-coordinate of {_readPosition} is not 12:
                    benchFailure("object read returned wrong position for id %{_id}%")
                if y-coordinate of {_readPosition} is not 64:
                    benchFailure("object read returned wrong height for id %{_id}%")
                if z-coordinate of {_readPosition} is not -9:
                    benchFailure("object read returned wrong z coordinate for id %{_id}%")
                if world of {_readPosition} is not world "world":
                    benchFailure("object read returned wrong world for id %{_id}%")
                if {_workload} = "objects":
                    if name of {_readItem} is not "Benchmark sword":
                        benchFailure("object read lost item name for id %{_id}%")
                    if lore of {_readItem} does not contain "Round-trip validation":
                        benchFailure("object read lost item lore for id %{_id}%")
    if {_replaced} is true:
        if {_target} = "local":
            if {_result::%{_extra}%::id} is set:
                benchFailure("local replacement retained an old row")
            if {_result::1::stale} is set:
                benchFailure("local replacement retained an old column")
        else:
            if {bench::rows::%{_extra}%::id} is set:
                benchFailure("global replacement retained an old row")
            if {bench::rows::1::stale} is set:
                benchFailure("global replacement retained an old column")
    if {_rows} > 5000:
        if {_stored} is not 0:
            benchFailure("over-limit read retained partial results")
        if {_readError} is not set:
            benchFailure("over-limit read did not report an error")
    else:
        if {_stored} is not {_rows}:
            benchFailure("%{_workload}% read stored %{_stored}% rows; expected %{_rows}%")
        if {_readError} is set:
            benchFailure("%{_workload}% read %{_rows}%: %{_readError}%")
    if {_legacy} is not "none":
        log "SKRIPTORM_BENCH %{_legacy}%read: rows=%{_rows}% ticks=%{bench::elapsed::ticks}% wallNs=%{bench::elapsed::ns}% gapNs=%{bench::tick::gap::max::ns}% stored=%{_stored}% total=%{_total}% error=%{_readError}%"
    else:
        log "SKRIPTORM_BENCH=SAMPLE read: workload=%{_workload}% source=%{_source}% target=%{_target}% replaced=%{_replaced}% sample=%{_sample}% rows=%{_rows}% ticks=%{bench::elapsed::ticks}% wallNs=%{bench::elapsed::ns}% gapNs=%{bench::tick::gap::max::ns}% stored=%{_stored}% total=%{_total}% %{bench::phases}% error=%{_readError}%"
    delete {bench::batch::*}
    delete {bench::rows::*}
    set {bench::case::busy} to false

every 5 seconds:
    if {bench::started::curve} is set:
        stop trigger
    set {bench::started::curve} to true
    wait 5 seconds
    set {bench::backend} to "__BENCH_TYPE__"
    if {bench::backend} = "JDBC":
        create a connection named "bench" to database "JDBC" with properties:
            driver: "org.sqlite.JDBC"
            url: "__BENCH_URL__"
    else if {bench::backend} = "MongoDB":
        create a connection named "bench" to database "MongoDB" with properties:
            url: "__BENCH_URL__"
            database: "skriptorm_benchmark"
    else:
        create a connection named "bench" to database "__BENCH_TYPE__" with properties:
            url: "__BENCH_URL__"
            username: "__BENCH_USERNAME__"
            password: "__BENCH_PASSWORD__"
    if last database error is set:
        benchFailure("connect: %last database error%")
        stop trigger
    in connection "bench":
        register a database table "orm_bench_probe":
            id: bigint, primary key, not null
            pad1: int, nullable
            pad2: int, nullable
            pad3: int, nullable
            pad4: int, nullable
            pad5: int, nullable
        register a database table "orm_bench_primitive":
            id: bigint, primary key, not null
            pad1: int, not null
            pad2: int, not null
            pad3: int, not null
            pad4: int, not null
            pad5: int, not null
        register a database table "orm_bench_objects":
            id: bigint, primary key, not null
            pad1: int, not null
            pad2: int, not null
            pad3: int, not null
            item: itemstack, not null
            position: location, not null
    if last database error is set:
        benchFailure("register tables: %last database error%")
        stop trigger
    set {bench::base} to 0

    # Compatible id-only curve; the 10,000-row read must reject the result.
    loop 100, 500, 1000, 2500, 5000 and 10000:
        benchRoundTrip(loop-value, "orm_bench_probe", "sparse", "global", "global", false, 0, "")
        while {bench::case::busy} is true:
            wait 1 tick
    benchRoundTrip(5000, "orm_bench_probe", "sparse", "global", "global", false, 0, "warm")
    while {bench::case::busy} is true:
        wait 1 tick

    # Alternate scopes on a warmed server. Warmups have negative sample numbers;
    # positive sample numbers identify the ten measured repetitions.
    loop 100, 500, 1000, 2500 and 5000:
        set {_rows} to loop-value
        loop {@warmups} + {@samples} times:
            set {_sample} to loop-number-2
            subtract {@warmups} from {_sample}
            if {_sample} <= 0:
                subtract 1 from {_sample}
            benchRoundTrip({_rows}, "orm_bench_primitive", "primitive", "local", "local", false, {_sample}, "none")
            while {bench::case::busy} is true:
                wait 1 tick
            benchRoundTrip({_rows}, "orm_bench_primitive", "primitive", "global", "global", false, {_sample}, "none")
            while {bench::case::busy} is true:
                wait 1 tick

    # Existing results and mixed scope combinations at the 5,000-row ceiling.
    loop {@warmups} + {@samples} times:
        set {_sample} to loop-number
        subtract {@warmups} from {_sample}
        if {_sample} <= 0:
            subtract 1 from {_sample}
        benchRoundTrip(5000, "orm_bench_primitive", "primitive", "local", "local", true, {_sample}, "none")
        while {bench::case::busy} is true:
            wait 1 tick
        benchRoundTrip(5000, "orm_bench_primitive", "primitive", "global", "global", true, {_sample}, "none")
        while {bench::case::busy} is true:
            wait 1 tick
        benchRoundTrip(5000, "orm_bench_primitive", "primitive", "local", "global", false, {_sample}, "none")
        while {bench::case::busy} is true:
            wait 1 tick
        benchRoundTrip(5000, "orm_bench_primitive", "primitive", "global", "local", false, {_sample}, "none")
        while {bench::case::busy} is true:
            wait 1 tick

    # Conversion is separate from the numeric curve. A 1,000-row workload keeps
    # repeated ItemStack and Location conversion practical on CI runners.
    loop {@warmups} + {@samples} times:
        set {_sample} to loop-number
        subtract {@warmups} from {_sample}
        if {_sample} <= 0:
            subtract 1 from {_sample}
        benchRoundTrip(1000, "orm_bench_objects", "mixed", "local", "local", false, {_sample}, "none")
        while {bench::case::busy} is true:
            wait 1 tick
        benchRoundTrip(1000, "orm_bench_objects", "mixed", "global", "global", false, {_sample}, "none")
        while {bench::case::busy} is true:
            wait 1 tick
        benchRoundTrip(1000, "orm_bench_objects", "objects", "local", "local", true, {_sample}, "none")
        while {bench::case::busy} is true:
            wait 1 tick

    wait 1 tick
    benchBegin()
    wait 6 seconds
    benchEnd()
    wait 1 tick
    set {bench::tick::watch} to false
    log "SKRIPTORM_BENCH calibrate: label=idle6s ticks=%{bench::elapsed::ticks}% windowNs=%{bench::elapsed::ns}% gapNs=%{bench::tick::gap::max::ns}% spun=0"
    loop 120000, 180000, 300000 and 900000:
        benchCalibrate(loop-value)
        while {bench::case::busy} is true:
            wait 1 tick
    set {bench::done::curve} to true

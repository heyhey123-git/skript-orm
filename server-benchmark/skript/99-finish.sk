# Stop after both benchmark scripts finish so Gradle can read the log. The timeout
# also stops a run that failed to report completion, even if the addon did not load.

every 5 seconds:
    if {bench::done::curve} is set:
        if {bench::done::compare} is set:
            log "SKRIPTORM_BENCH=DONE"
            stop the server

every 15 minutes:
    log "SKRIPTORM_BENCH=FAIL the benchmark did not finish"
    stop the server

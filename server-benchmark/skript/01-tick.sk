# A tick-start observer for each benchmark window. The gap is the interval between
# consecutive runs of this trigger, not the CPU time spent in either tick.
import:
    java.lang.System

every tick:
    if {bench::tick} is not set:
        set {bench::tick} to 0
    add 1 to {bench::tick}

    set {_now} to System.nanoTime()
    if {bench::tick::watch} is true:
        if {bench::tick::last} is set:
            set {_gap} to {_now} - {bench::tick::last}
            if {bench::tick::gap::max::ns} is not set:
                set {bench::tick::gap::max::ns} to {_gap}
            else if {_gap} is greater than {bench::tick::gap::max::ns}:
                set {bench::tick::gap::max::ns} to {_gap}
    set {bench::tick::last} to {_now}

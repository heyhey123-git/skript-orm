# Examples for docs/cookbook.md. The server test parses these commands but does not run them.
# This checks syntax, not runtime behavior; keep this file and the documentation in sync when editing.
#
# Events such as `on load` and `on join` are replaced with commands to avoid running database operations
# during the test. Command names must be unique across docs/examples/, since all files load together.
# For example, getting-started.sk already defines /example-adduser, so this file uses
# /example-adduser-with-id. Messages follow the English page; the Chinese page uses Chinese messages.
#
# These are not ready-to-run scripts. Set up the connection and each recipe's tables before using them.
# The `users` definition in getting-started.sk does not cover every column used in this file.

# "Know the id of a row you just created": the plugin does not return generated IDs.
# This example assigns an ID using a global counter, then saves the row with `upsert`.
command /example-adduser-with-id <text>:
    trigger:
        if {users::next-id} is not set:
            set {users::next-id} to 0
        add 1 to {users::next-id}
        upsert one entity in table "users" by id {users::next-id} and wait:
            values:
                name: arg-1
        if last database error is set:
            send "Could not store %arg-1%: %last database error%" to sender
            stop
        send "Stored %arg-1% as id {users::next-id}." to sender

# "One row per player": use the player's UUID as the primary key to keep one row per player.
# The documentation runs this code in an `on join` event.
command /example-join:
    trigger:
        upsert one entity in table "players" by id uuid of player and wait:
            values:
                name: name of player
                last_seen: now
        if last database error is set:
            send "Could not save your data: %last database error%" to console

# "Read, change, store back": update only the columns listed in `values`; other columns stay unchanged.
command /example-addage <integer>:
    trigger:
        select one entity from table "players" and store the result in {_row::*}:
            where all:
                uuid = uuid of player
        if {_row::uuid} is not set:
            send "No row for you yet." to sender
            stop
        set {_age} to {_row::age}
        if {_age} is not set:
            set {_age} to 0
        set {_new-age} to {_age} + arg-1
        update one entity in table "players" by id uuid of player and wait:
            values:
                age: {_new-age}
        if last database error is set:
            send "Could not update: %last database error%" to sender
            stop
        send "Your age is now %{_new-age}%." to sender

# "Copy rows between tables": `select many` results can be passed directly to `insert many`.
# The insert finishes before the script continues to the delete.
command /example-archive:
    trigger:
        select many entities from table "users" and store the results in {_rows::*}:
            where all:
                active = false

        insert many {_rows::*} into table "archived_users" and wait
        if last database error is set:
            send "Archive failed: %last database error%" to console
            stop

        delete entities from table "users" and wait:
            where all:
                active = false

# "Build rows in a script and insert them": number rows from 1, as in query results.
command /example-insert-built-rows:
    trigger:
        set {_rows::1::name} to "Alice"
        set {_rows::1::age} to 25
        set {_rows::2::name} to "Bob"
        set {_rows::2::age} to 30

        insert many {_rows::*} into table "users" and wait

# "Walk every page": read until a page is empty, with a safety limit of 100 pages.
command /example-walk-pages:
    trigger:
        set {_page} to 1
        while {_page} <= 100:
            select page {_page} with size 50 from table "users" and store the results in {_page-rows::*}:
                where all:
                    active = true
            # Check each row's primary key to find the end of the results. A nullable column could
            # be unset in an existing row and stop the loop too early. If {_row} is still 1 afterwards,
            # the page was empty.
            set {_row} to 1
            while {_page-rows::%{_row}%::id} is set:
                send "%{_page-rows::%{_row}%::name}%" to console
                add 1 to {_row}
            if {_row} is 1:
                exit loop
            add 1 to {_page}

# "Store an item's NBT": requires SkBee and the `tools` table defined in the documentation.
command /example-savetool:
    trigger:
        insert one entity into table "tools" and wait:
            values:
                data: nbt of player's tool
        if last database error is set:
            send "Could not save the tool: %last database error%" to sender
            stop
        send "Saved." to sender

# "Delete old rows in batches": stop when a batch deletes fewer than 500 rows.
# The loop runs at most ten times and keeps a total of the deleted rows.
command /example-prune:
    trigger:
        set {_cutoff} to now - 30 days
        set {_pruned} to 0
        loop 10 times:
            delete entities from table "logs" with limit 500 and store affected rows in {_deleted} and wait:
                where all:
                    created < {_cutoff}
            if last database error is set:
                send "Prune failed: %last database error%" to console
                exit loop
            add {_deleted} to {_pruned}
            if {_deleted} is less than 500:
                exit loop
        send "Pruned %{_pruned}% old rows." to sender

# "Use the table from a second script": check the readiness flag before querying.
# The setup script shown in the documentation creates the connection, registers the table, and sets
# {database::ready}. That setup is not included here; /example-connect does not set this flag.
command /example-second-script:
    trigger:
        if {database::ready} is not true:
            send "The database is not ready yet." to sender
            stop
        select one entity from table "users" and store the result in {_user::*}:
            where all:
                name = "Alice"
        send "%{_user::name}%"

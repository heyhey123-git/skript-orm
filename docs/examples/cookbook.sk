# The recipes from docs/cookbook.md, kept here so the server test parses them. They are written as
# commands rather than as `on load` and `on join` triggers for the same reason as the other examples:
# this file is only read, never run, and a trigger that fired would act on the test server.
#
# Two things therefore differ from the pages that show these recipes, and they are the two a reader
# comparing the two ends up asking about:
#
#   - Every recipe is wrapped in a `command /example-…`, because a command nobody types never runs. The
#     names cannot be the ones the page uses: every file in this directory is loaded on the same test
#     server, so two of them cannot define the same command. `/example-adduser` is already
#     getting-started.sk's, which is why the cookbook's own adduser command is `/example-adduser-with-id`.
#   - The messages are the ones from docs/cookbook.md, the English page, because that is the page this
#     file is the copy of. docs/cookbook.zh-CN.md carries the same recipes with Chinese messages.
#
# A recipe that needs a connection or a registered table does not repeat them here: getting-started.sk
# registers the `users` table in `/example-connect`, and only one script may create the connection.

# Recipe "Know the id of a row you just created". The plugin hands back no generated id, so the counter
# keeps one in a global and `upsert` writes the row under it.
command /example-adduser-with-id <text>:
    trigger:
        if {users::next-id} is not set:
            set {users::next-id} to 0
        add 1 to {users::next-id}
        upsert one entity in table "users" by id {users::next-id} and wait:
            values:
                name: arg-1
        if last database error is set:
            send "Could not store %arg-1%: %last database error%" to sender
            stop
        send "Stored %arg-1% as id {users::next-id}." to sender

# Recipe "One row per player": the uuid is the primary key, so the player is the identity and `upsert`
# keeps exactly one row per player. The page shows this as `on join:`; the body is the same.
command /example-join:
    trigger:
        upsert one entity in table "players" by id uuid of player and wait:
            values:
                name: name of player
                last_seen: now
        if last database error is set:
            send "Could not save your data: %last database error%" to console

# Recipe "Read, change, store back". Only the columns in the values block are written, so the rest of
# the row is left alone.
command /example-addage <integer>:
    trigger:
        select one entity from table "players" and store the result in {_row::*}:
            where all:
                uuid = uuid of player
        if {_row::uuid} is not set:
            send "No row for you yet." to sender
            stop
        set {_age} to {_row::age}
        if {_age} is not set:
            set {_age} to 0
        set {_new-age} to {_age} + arg-1
        update one entity in table "players" by id uuid of player and wait:
            values:
                age: {_new-age}
        if last database error is set:
            send "Could not update: %last database error%" to sender
            stop
        send "Your age is now %{_new-age}%." to sender

# Recipe "Copy rows between tables". What `select many` fills is already the shape `insert many` reads,
# and the insert waits, so the delete cannot run before it.
command /example-archive:
    trigger:
        select many entities from table "users" and store the results in {_rows::*}:
            where all:
                active = false

        insert many {_rows::*} into table "archived_users" and wait
        if last database error is set:
            send "Archive failed: %last database error%" to console
            stop

        delete entities from table "users" and wait:
            where all:
                active = false

# Recipe "Build rows in a script and insert them". The row index is one-based, exactly like the keys a
# read produces.
command /example-insert-built-rows:
    trigger:
        set {_rows::1::name} to "Alice"
        set {_rows::1::age} to 25
        set {_rows::2::name} to "Bob"
        set {_rows::2::age} to 30

        insert many {_rows::*} into table "users" and wait

# Recipe "Walk every page". There is no count query, so the script pages until a page comes back empty.
command /example-walk-pages:
    trigger:
        set {_page} to 1
        while {_page} <= 100:
            select page {_page} with size 50 from table "users" and store the results in {_page-rows::*}:
                where all:
                    active = true
            # Walk the row indices, testing the primary key: every row is a sub-list, so a row index is
            # done when the next row's key is unset. The key and not another column, because a NULL
            # column leaves its key unset too and would end the walk at that row. `{_row} is 1` after the
            # walk means the page was empty.
            set {_row} to 1
            while {_page-rows::%{_row}%::id} is set:
                send "%{_page-rows::%{_row}%::name}%" to console
                add 1 to {_row}
            if {_row} is 1:
                exit loop
            add 1 to {_page}

# Recipe "Store an item's NBT", which needs SkBee and the `tools` table the page registers above it.
command /example-savetool:
    trigger:
        insert one entity into table "tools" and wait:
            values:
                data: nbt of player's tool
        if last database error is set:
            send "Could not save the tool: %last database error%" to sender
            stop
        send "Saved." to sender

# Recipe "Delete old rows in batches". The delete reports how many rows it removed, so a batch that comes
# back short is the end of the work and the loop stops there instead of running all ten times.
command /example-prune:
    trigger:
        set {_cutoff} to now - 30 days
        set {_pruned} to 0
        loop 10 times:
            delete entities from table "logs" with limit 500 and store affected rows in {_deleted} and wait:
                where all:
                    created < {_cutoff}
            if last database error is set:
                send "Prune failed: %last database error%" to console
                exit loop
            add {_deleted} to {_pruned}
            if {_deleted} is less than 500:
                exit loop
        send "Pruned %{_pruned}% old rows." to sender

# Recipe "Use the table from a second script", the `users.sk` half: the connection and the tables belong
# to one script, and this one only asks whether that script got there. The page's `database.sk` half is
# getting-started.sk's `/example-connect`, plus the `{database::ready}` flag it sets.
command /example-second-script:
    trigger:
        if {database::ready} is not true:
            send "The database is not ready yet." to sender
            stop
        select one entity from table "users" and store the result in {_user::*}:
            where all:
                name = "Alice"
        send "%{_user::name}%"

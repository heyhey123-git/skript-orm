# Examples for docs/raw-statements.md. The server test parses these commands but does not run them,
# so they check the syntax the page shows and nothing else.
#
# The `with` clause takes one value or a list variable. A list written out of literals — `with (30, "Alice")`
# — is refused while the script is parsed, because Skript hands such a list to the statement as unparsed
# literals, which it will not read once the script runs. That is why the examples below pair `with {_values::*}`
# with a variable.

command /example-raw-query <integer>:
    trigger:
        # A statement with no parameter at all, which is the common shape for DDL.
        in connection "example":
            execute update "ALTER TABLE users ADD COLUMN age INT NULL"
        if last database error is set:
            send "The migration failed: %last database error%" to sender

        # One value, written where the `?` is.
        in connection "example":
            execute query "SELECT id, name FROM users WHERE age > ?" with (18) and store the result in {_rows::*}
        if last database error is set:
            send "The read failed: %last database error%" to sender
        if {_rows::1::name} is set:
            send "The first row is %{_rows::1::name}%."

        # More than one value, read from a list variable in the order the `?` characters appear.
        set {_values::*} to 30, "Alice"
        in connection "example":
            execute update "UPDATE users SET age = ? WHERE name = ?" with {_values::*} and store affected rows in {_rows}
        if last database error is set:
            send "The update failed: %last database error%" to sender
        send "%{_rows}% row(s) were affected."

        # A statement the server does not count reports 0, and that 0 is stored as it stands.
        in connection "example":
            execute update "CREATE INDEX IF NOT EXISTS users_age ON users (age)" and store affected rows in {_count}
        send "The server reported %{_count}% row(s) for the index."

command /example-raw-command:
    trigger:
        # A document connection takes `execute command` instead: JSON text, answered with one document.
        in connection "example":
            execute command "{ ""count"": ""users"" }" and store the result in {_answer::*}
        if last database error is set:
            send "The command failed: %last database error%" to sender
        send "There are %{_answer::n}% users."

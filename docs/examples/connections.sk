# Examples for docs/connections.md. The server test parses these commands but does not run them.
# This checks syntax, not runtime behavior. Connection setup uses commands instead of `on load`
# events so loading this file does not create connections or affect the test server's setup.

command /example-named-connection:
    trigger:
        create a connection named "logs" to database "MySQL" with properties:
            url: "jdbc:mysql://localhost:3306/logs"
            username: "root"
            password: "123456"
        if last database error is set:
            send "Connection failed: %last database error%" to console
            stop

        # Register the table on the "logs" connection. Table registrations are local to each connection.
        in connection "logs":
            register a database table "entries":
                id: bigint, primary key, auto increment, not null
                message: string(255), not null

command /example-write-to-logs <text>:
    trigger:
        in connection "logs":
            insert one entity into table "entries" and wait:
                values:
                    message: arg-1
        if last database error is set:
            send "Could not write the entry: %last database error%" to sender

command /example-read-from-logs:
    trigger:
        in connection "logs":
            select many entities from table "entries" and store the results in {_entries::*}

command /example-use-logs:
    trigger:
        use connection "logs"
        select one entity from table "entries" and store the result in {_entry::*}

command /example-switch-default:
    trigger:
        make connection "logs" the default

command /example-close-connections:
    trigger:
        disconnect from connection "logs"
        disconnect from all connections

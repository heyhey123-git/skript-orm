# Finishes the run, or fails it.
#
# Each script records itself in {skriptorm::selftest::done::*} once its detail line is in the log, so
# this stops the server as soon as they have all reported. Its second trigger is what turns a hung run
# into a failing one, and it uses no addon syntax, so it also runs when the addon is the thing that
# broke.
#
# `prepareServerTest` writes this file with `__ELEMENT_COUNT__` replaced by the number of scripts it
# copied that report a detail line, so the count cannot drift from the scripts that exist. A mismatch
# is still reported rather than hidden: the failure line says how many arrived.

every 5 seconds:
    if size of {skriptorm::selftest::done::*} is __ELEMENT_COUNT__:
        log "SKRIPTORM_SELFTEST=PASS"
        stop the server

# The budget is generous on purpose: a hung run has to fail, but a run that is merely slow must not. The
# scripts that wait for a second tick and then move more rows than fit in one tick — the SQLite round trip
# and the row ceiling, which fills a table past the ceiling one row at a time — take about fifteen seconds
# between them, and how much of that depends on the disk rather than on the code.
every 60 seconds:
    log "SKRIPTORM_SELFTEST=FAIL the self-test did not finish: %size of {skriptorm::selftest::done::*}% of __ELEMENT_COUNT__ elements reported"
    stop the server

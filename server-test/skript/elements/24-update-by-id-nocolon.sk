# update by id from a variable, without a colon
#
# No colon on purpose: this write takes its values from the variable, so there is nothing to indent, and
# Skript warns about every section that has none.
every 5 seconds:
    if {xiaojie::selftest::done::update-by-id-nocolon} is set:
        stop trigger

    set {_row::age} to 1 + 1
    update one entity {_row::*} in table "orm_selftest" by id 1 and wait
    log "XIAOJIE_SELFTEST detail: update by id without colon -> %last database error%"
    set {xiaojie::selftest::done::update-by-id-nocolon} to true

# raw statements, against the SQLite file connection the suite already carries
#
# This script is the only place the raw statements run for real without a database server, because the
# driver is Paper's own and the file lives under Skript's directory. It covers both halves of what the
# feature promises: a correct statement returns what the server returned, and the guards refuse before
# anything is sent.
#
# It creates its own table rather than using `orm_sqlite_probe`, so the two scripts cannot interfere, and
# it drops it first so the run is repeatable after a crash.
every 5 seconds:
    if {skriptorm::selftest::done::raw-sql} is set:
        stop trigger
    if {skriptorm::selftest::started::raw-sql} is set:
        stop trigger
    set {skriptorm::selftest::started::raw-sql} to true

    create a connection named "raw" to database "JDBC" with properties:
        driver: "org.sqlite.JDBC"
        url: "jdbc:sqlite:plugins/Skript/raw-probe.db"
    if last database error is set:
        log "SKRIPTORM_SELFTEST=FAIL raw connect: %last database error%"

    in connection "raw":
        execute update "DROP TABLE IF EXISTS raw_probe"
    if last database error is set:
        log "SKRIPTORM_SELFTEST=FAIL raw drop: %last database error%"

    # DDL is a raw statement a declaration cannot express, and the count a server reports for it is 0
    # rather than nothing: the clause is read here so that a count which stopped arriving is visible.
    in connection "raw":
        set {_rows} to 7
        execute update "CREATE TABLE raw_probe (id INTEGER PRIMARY KEY, name TEXT, age INTEGER)" and store affected rows in {_rows}
    if last database error is set:
        log "SKRIPTORM_SELFTEST=FAIL raw create: %last database error%"
    if {_rows} is not 0:
        log "SKRIPTORM_SELFTEST=FAIL raw create count read '%{_rows}%' instead of the server's 0"

    # Two rows in one statement: the parameters are bound by position, and the count is what the server
    # affected. The values come from a list variable rather than out of literals, because a list written out
    # of literals cannot be read by a statement that runs later; the single-value statements below can.
    in connection "raw":
        set {_params::*} to 1, "Alice", 30, 2, "Bob", and 40
        set {_rows} to 7
        execute update "INSERT INTO raw_probe (id, name, age) VALUES (?, ?, ?), (?, ?, ?)" with {_params::*} and store affected rows in {_rows}
    if last database error is set:
        log "SKRIPTORM_SELFTEST=FAIL raw insert: %last database error%"
    if {_rows} is not 2:
        log "SKRIPTORM_SELFTEST=FAIL raw insert count read '%{_rows}%' instead of 2"

    # The read path: rows keyed by the column label and numbered from one, with no conversion applied.
    in connection "raw":
        execute query "SELECT id, name, age FROM raw_probe WHERE age > ? ORDER BY id" with (35) and store the result in {raw::rows::*}
    if last database error is set:
        log "SKRIPTORM_SELFTEST=FAIL raw query: %last database error%"
    if {raw::rows::1::name} is not "Bob":
        log "SKRIPTORM_SELFTEST=FAIL raw query read name '%{raw::rows::1::name}%' instead of 'Bob'"
    if {raw::rows::1::age} is not 40:
        log "SKRIPTORM_SELFTEST=FAIL raw query read age '%{raw::rows::1::age}%' instead of 40"
    if {raw::rows::2::name} is set:
        log "SKRIPTORM_SELFTEST=FAIL raw query returned more rows than the filter matched"

    # An alias is the key a script reads, which is what makes a computed column usable.
    in connection "raw":
        execute query "SELECT name AS who FROM raw_probe WHERE id = ?" with (1) and store the result in {raw::alias::*}
    if last database error is set:
        log "SKRIPTORM_SELFTEST=FAIL raw alias: %last database error%"
    if {raw::alias::1::who} is not "Alice":
        log "SKRIPTORM_SELFTEST=FAIL raw alias read '%{raw::alias::1::who}%' instead of 'Alice'"

    # A read that matched nothing is an empty variable, not a failure.
    in connection "raw":
        execute query "SELECT name FROM raw_probe WHERE id = ?" with (99) and store the result in {raw::none::*}
    if last database error is set:
        log "SKRIPTORM_SELFTEST=FAIL raw empty: %last database error%"
    if {raw::none::1::name} is set:
        log "SKRIPTORM_SELFTEST=FAIL raw empty returned '%{raw::none::1::name}%'"

    # A read leaves nothing behind from the read before it, the rule every read in this addon follows.
    in connection "raw":
        execute query "SELECT name FROM raw_probe WHERE id = ?" with (1) and store the result in {raw::reused::*}
    if last database error is set:
        log "SKRIPTORM_SELFTEST=FAIL raw reused setup: %last database error%"
    in connection "raw":
        execute query "SELECT name FROM raw_probe WHERE id = ?" with (99) and store the result in {raw::reused::*}
    if {raw::reused::1::name} is set:
        log "SKRIPTORM_SELFTEST=FAIL raw read left '%{raw::reused::1::name}%' from the read before it"

    # A statement that fails at the database reports the server's own words, and the error slot holds them.
    in connection "raw":
        execute query "SELECT nope FROM raw_probe" and store the result in {raw::bad::*}
    if last database error is not set:
        log "SKRIPTORM_SELFTEST=FAIL raw bad read reported nothing"
    if {raw::bad::1::nope} is set:
        log "SKRIPTORM_SELFTEST=FAIL raw bad read stored a row"

    # The guards. Each one refuses before anything is sent, which is why it can be checked here without a
    # server that would accept the statement.
    in connection "raw":
        execute update "   " and store affected rows in {_empty}
    if last database error does not contain "The raw statement is empty.":
        log "SKRIPTORM_SELFTEST=FAIL raw empty statement was not refused: %last database error%"
    if {_empty} is set:
        log "SKRIPTORM_SELFTEST=FAIL raw empty statement wrote a count"

    in connection "raw":
        execute query "SELECT id, name, age FROM raw_probe WHERE age > ? AND id < ?" with (1) and store the result in {raw::arity::*}
    if last database error does not contain "2 parameter placeholder(s) ('?'), but 1 value(s) were given.":
        log "SKRIPTORM_SELFTEST=FAIL raw placeholder count was not refused: %last database error%"
    if {raw::arity::1::id} is set:
        log "SKRIPTORM_SELFTEST=FAIL raw placeholder mismatch stored a row"

    # The wrong kind of statement for this connection: SQLite takes SQL, so a command document is refused
    # by the backend's own default rather than parsed as anything.
    in connection "raw":
        execute command "{ ""count"": ""raw_probe"" }" and store the result in {raw::command::*}
    if last database error does not contain "Raw commands are not supported by database 'JDBC'.":
        log "SKRIPTORM_SELFTEST=FAIL raw command was not refused by name: %last database error%"
    if last database error does not contain "It takes raw SQL statements instead:":
        log "SKRIPTORM_SELFTEST=FAIL raw command refusal did not name the alternative: %last database error%"

    in connection "raw":
        execute update "DROP TABLE IF EXISTS raw_probe"
    if last database error is set:
        log "SKRIPTORM_SELFTEST=FAIL raw cleanup: %last database error%"

    log "SKRIPTORM_SELFTEST detail: raw sql -> ok"
    set {skriptorm::selftest::done::raw-sql} to true

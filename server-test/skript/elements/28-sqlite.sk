# The generic `"JDBC"` type, on the SQLite driver a Paper server already carries.
#
# The other elements drive one type name or stop at the database lookup, so this is the only script
# that covers the half of `"JDBC"` a script supplies itself (the driver class and the url), and the
# only one whose values reach a driver the project does not test against anywhere else. It runs in
# both modes, because it needs nothing from the runner: the driver is Paper's own, and the database is
# a file under Skript's directory, which `prepareServerTest` deletes before every run, so the table
# below is always created fresh.
#
# Every statement is scoped to the connection this script made. In database mode the default is the
# MySQL connection `00-setup.sk` owns, and an unqualified statement would resolve to that one.
#
# The detail line it reports is the word `ok` or the word `failed`, and a FAIL line above it names what
# did not hold, so the build can require that word instead of accepting whatever arrived.
every 5 seconds:
    if {skriptorm::selftest::done::sqlite} is set:
        stop trigger
    if {skriptorm::selftest::started::sqlite} is set:
        stop trigger
    set {skriptorm::selftest::started::sqlite} to true

    # Every other element reports on the first tick, and a connection made before that would be the
    # default their unqualified statements resolve to. This one starts after they are all done.
    wait 6 seconds

    create a connection named "sqlite" to database "JDBC" with properties:
        driver: "org.sqlite.JDBC"
        url: "jdbc:sqlite:plugins/Skript/sqlite-probe.db"
    if last database error is set:
        log "SKRIPTORM_SELFTEST=FAIL sqlite connect: %last database error%"

    # No auto increment: the generic dialect refuses it, so the key is written out. That it refuses is
    # checked at the end of this script. The names avoid a `sqlite_` prefix, which SQLite reserves for
    # its own objects and refuses to create a table under.
    in connection "sqlite":
        register a database table "orm_sqlite_probe":
            id: bigint, primary key, not null
            name: string(64), not null
            age: int, nullable
    if last database error is set:
        log "SKRIPTORM_SELFTEST=FAIL sqlite register table: %last database error%"

    in connection "sqlite":
        insert one entity into table "orm_sqlite_probe" and wait:
            values:
                id: 1
                name: "Alice"
                age: 30
    if last database error is set:
        log "SKRIPTORM_SELFTEST=FAIL sqlite insert one: %last database error%"

    in connection "sqlite":
        insert one entity into table "orm_sqlite_probe" and wait:
            values:
                id: 2
                name: "Bob"
                age: 40
    if last database error is set:
        log "SKRIPTORM_SELFTEST=FAIL sqlite insert two: %last database error%"

    # A literal id, which is the form a `%object%` slot has to give a type before it can read it.
    in connection "sqlite":
        select one entity from table "orm_sqlite_probe" by id 1 and store the result in {sqlite::by-id::*}
    if last database error is set:
        log "SKRIPTORM_SELFTEST=FAIL sqlite select by id: %last database error%"

    in connection "sqlite":
        select many entities from table "orm_sqlite_probe" and store the results in {sqlite::many::*}:
            where all:
                age >= 20
    if last database error is set:
        log "SKRIPTORM_SELFTEST=FAIL sqlite select many: %last database error%"

    # Page two of one row per page: the only statement here that binds a limit and an offset, and the
    # ordering pagination uses is the primary key.
    in connection "sqlite":
        select page 2 with size 1 from table "orm_sqlite_probe" and store the results in {sqlite::page::*}:
            where all:
                id >= 1
    if last database error is set:
        log "SKRIPTORM_SELFTEST=FAIL sqlite select page: %last database error%"

    in connection "sqlite":
        update one entity in table "orm_sqlite_probe" by id 2 and store affected rows in {sqlite::rows::update} and wait:
            values:
                name: "Carol"
    if last database error is set:
        log "SKRIPTORM_SELFTEST=FAIL sqlite update: %last database error%"
    if {sqlite::rows::update} is not 1:
        log "SKRIPTORM_SELFTEST=FAIL sqlite affected rows read '%{sqlite::rows::update}%' for an update of one row, instead of 1"

    in connection "sqlite":
        select one entity from table "orm_sqlite_probe" by id 2 and store the result in {sqlite::updated::*}
    if last database error is set:
        log "SKRIPTORM_SELFTEST=FAIL sqlite select after update: %last database error%"

    in connection "sqlite":
        delete one entity from table "orm_sqlite_probe" by id 2 and wait
    if last database error is set:
        log "SKRIPTORM_SELFTEST=FAIL sqlite delete: %last database error%"

    in connection "sqlite":
        select many entities from table "orm_sqlite_probe" and store the results in {sqlite::left::*}:
            where all:
                id >= 1
    if last database error is set:
        log "SKRIPTORM_SELFTEST=FAIL sqlite select after delete: %last database error%"

    # The dialect refuses these wherever it does not know the database, and SQLite is one of those. A
    # statement that stopped being refused would be a silent change of what the type name promises, so
    # the message is checked rather than only the failure.
    in connection "sqlite":
        upsert one entity in table "orm_sqlite_probe" by id 1 and wait:
            values:
                name: "Alice"
    if last database error does not contain "Upsert is not supported by this JDBC dialect.":
        log "SKRIPTORM_SELFTEST=FAIL sqlite upsert was not refused: %last database error%"

    in connection "sqlite":
        insert one entity if absent into table "orm_sqlite_probe" and wait:
            values:
                id: 3
                name: "Dave"
    if last database error does not contain "Insert-if-absent is not supported by this JDBC dialect.":
        log "SKRIPTORM_SELFTEST=FAIL sqlite insert if absent was not refused: %last database error%"

    in connection "sqlite":
        delete entities from table "orm_sqlite_probe" with limit 10 and wait:
            where all:
                name = "nobody"
    if last database error does not contain "Limited delete is not supported by this JDBC dialect.":
        log "SKRIPTORM_SELFTEST=FAIL sqlite limited delete was not refused: %last database error%"

    in connection "sqlite":
        register a database table "orm_sqlite_auto":
            id: bigint, primary key, auto increment, not null
            name: string(64), not null
    if last database error does not contain "Auto increment is not supported by this JDBC dialect.":
        log "SKRIPTORM_SELFTEST=FAIL sqlite auto increment was not refused: %last database error%"

    # The affected row count, which is the one thing the statements above compute and never read. Each
    # variable is seeded with a number no statement here can report, so a check that passes without the
    # clause doing anything would fail: silence is not allowed to look like the right answer.
    #
    # The delete and the insert also settle what the row count means on this driver: zero rows for a
    # statement that matched nothing, one row for each row it wrote.
    in connection "sqlite":
        set {sqlite::rows::none} to 7
        update one entity in table "orm_sqlite_probe" by id 999 and store affected rows in {sqlite::rows::none} and wait:
            values:
                name: "Nobody"
    if last database error is set:
        log "SKRIPTORM_SELFTEST=FAIL sqlite affected rows update: %last database error%"
    if {sqlite::rows::none} is not set:
        log "SKRIPTORM_SELFTEST=FAIL sqlite affected rows left the variable unset after a statement that matched nothing"
    if {sqlite::rows::none} is not 0:
        log "SKRIPTORM_SELFTEST=FAIL sqlite affected rows read '%{sqlite::rows::none}%' for an update that matched no row, instead of 0"

    in connection "sqlite":
        delete one entity from table "orm_sqlite_probe" by id 1 and store affected rows in {sqlite::rows::delete} and wait
    if last database error is set:
        log "SKRIPTORM_SELFTEST=FAIL sqlite affected rows delete: %last database error%"
    if {sqlite::rows::delete} is not 1:
        log "SKRIPTORM_SELFTEST=FAIL sqlite affected rows read '%{sqlite::rows::delete}%' for a delete that removed one row, instead of 1"

    # A statement the dialect refuses never reaches the driver, and it leaves the variable unset: what a
    # script must not read is a number left over from the statement before it.
    in connection "sqlite":
        set {sqlite::rows::refused} to 7
        insert one entity if absent into table "orm_sqlite_probe" and store affected rows in {sqlite::rows::refused} and wait:
            values:
                id: 3
                name: "Dave"
    if {sqlite::rows::refused} is set:
        log "SKRIPTORM_SELFTEST=FAIL sqlite affected rows kept '%{sqlite::rows::refused}%' after a statement that was refused"

    in connection "sqlite":
        insert one entity into table "orm_sqlite_probe" and store affected rows in {sqlite::rows::insert} and wait:
            values:
                id: 4
                name: "Erin"
                age: 50
    if last database error is set:
        log "SKRIPTORM_SELFTEST=FAIL sqlite affected rows insert: %last database error%"
    if {sqlite::rows::insert} is not 1:
        log "SKRIPTORM_SELFTEST=FAIL sqlite affected rows read '%{sqlite::rows::insert}%' for an insert of one row, instead of 1"

    # `and wait` is accepted and unnecessary: the same statement written without it has its count ready on
    # the next line, because a write waits for its work either way. The seed is what tells "wrote nothing"
    # from "wrote the count": 7 would still be in there, or the variable would be empty, if it did not.
    in connection "sqlite":
        set {sqlite::rows::without-wait} to 7
        update one entity in table "orm_sqlite_probe" by id 4 and store affected rows in {sqlite::rows::without-wait}:
            values:
                age: 51
    if {sqlite::rows::without-wait} is not 1:
        log "SKRIPTORM_SELFTEST=FAIL sqlite affected rows read '%{sqlite::rows::without-wait}%' for a statement written without and wait, instead of 1"

    in connection "sqlite":
        select one entity from table "orm_sqlite_probe" by id 4 and store the result in {sqlite::rows::row::*}
    if {sqlite::rows::row::age} is not 51:
        log "SKRIPTORM_SELFTEST=FAIL sqlite affected rows left the write undone: age reads '%{sqlite::rows::row::age}%'"

    # A local variable is the form a script writes, and it is the one a waiting statement has to be careful
    # with: the event's own local variables are taken away while the work runs and put back around the
    # continuation, so a count written before that would not survive it.
    in connection "sqlite":
        delete one entity from table "orm_sqlite_probe" by id 999 and store affected rows in {_local_rows} and wait
    if {_local_rows} is not set:
        log "SKRIPTORM_SELFTEST=FAIL sqlite affected rows left a local variable unset"
    if {_local_rows} is not 0:
        log "SKRIPTORM_SELFTEST=FAIL sqlite affected rows read '%{_local_rows}%' from a local variable, instead of 0"

    # A failure the database itself reports has to end a transaction the way a refusal does: the
    # statements after it do nothing, the body rolls back, and the cause stays readable. The suite only
    # had the refusal case (a missing table), which never reaches the database at all.
    in connection "sqlite":
        database transaction:
            insert one entity into table "orm_sqlite_probe" and wait:
                values:
                    id: 96
                    name: "before-the-failure"
            insert one entity into table "orm_sqlite_probe" and wait:
                values:
                    id: 4
                    name: "duplicate"
            insert one entity into table "orm_sqlite_probe" and wait:
                values:
                    id: 97
                    name: "after-the-failure"
    if last database error is not set:
        log "SKRIPTORM_SELFTEST=FAIL sqlite transaction dropped the failure that rolled it back"
    in connection "sqlite":
        select many entities from table "orm_sqlite_probe" and store the results in {sqlite::tx::*}:
            where all:
                id >= 96
    if {sqlite::tx::1::id} is set:
        log "SKRIPTORM_SELFTEST=FAIL sqlite transaction kept a row its failure should have undone"

    # Naming the connection the transaction already runs on keeps the statements inside it: the frame the
    # switch pushes carries the transaction, so a statement under it still rolls back with the rest.
    # Without that, it ran on a pooled connection, committed on the spot and survived the rollback.
    in connection "sqlite":
        database transaction:
            insert one entity into table "orm_sqlite_probe" and wait:
                values:
                    id: 96
                    name: "outer"
            in connection "sqlite":
                insert one entity into table "orm_sqlite_probe" and wait:
                    values:
                        id: 97
                        name: "inner"
            insert one entity into table "orm_sqlite_probe" and wait:
                values:
                    id: 4
                    name: "duplicate"
    in connection "sqlite":
        select many entities from table "orm_sqlite_probe" and store the results in {sqlite::tx::switch::*}:
            where all:
                id >= 96
    if {sqlite::tx::switch::1::id} is set:
        log "SKRIPTORM_SELFTEST=FAIL sqlite a switch to the same connection left the transaction"

    # The cause of a rollback survives the rollback a script asks for, the same way it survives the
    # automatic one, so `last database error` after the section still says what went wrong.
    in connection "sqlite":
        database transaction:
            insert one entity into table "orm_sqlite_probe" and wait:
                values:
                    id: 4
                    name: "duplicate"
            rollback database transaction
    if last database error is not set:
        log "SKRIPTORM_SELFTEST=FAIL sqlite an explicit rollback dropped the failure that caused it"

    # A number the column cannot hold is refused rather than stored as something else. SQLite is the
    # right place for this: its columns are dynamically typed, so it would happily keep the wrong number
    # and the only thing that can object is the check the plugin makes before binding.
    in connection "sqlite":
        insert one entity into table "orm_sqlite_probe" and wait:
            values:
                id: 96
                name: "too-big"
                age: 5000000000
    if last database error does not contain "does not fit column 'age'":
        log "SKRIPTORM_SELFTEST=FAIL sqlite accepted a number no int column can hold: %last database error%"

    in connection "sqlite":
        set {_row::id} to 97
        set {_row::name} to "from-a-variable"
        set {_row::age} to 5000000000
    in connection "sqlite":
        insert one {_row::*} into table "orm_sqlite_probe" and wait
    if last database error does not contain "does not fit column 'age'":
        log "SKRIPTORM_SELFTEST=FAIL sqlite accepted a variable number no int column can hold: %last database error%"

    in connection "sqlite":
        select many entities from table "orm_sqlite_probe" and store the results in {sqlite::numeric::where::*}:
            where all:
                age > 5000000000
    if last database error does not contain "does not fit column 'age'":
        log "SKRIPTORM_SELFTEST=FAIL sqlite compared a where value no int column can hold: %last database error%"

    # A fraction is still cut towards zero, which is what Skript does everywhere else: only the case
    # that used to be silently wrong changed.
    in connection "sqlite":
        insert one entity into table "orm_sqlite_probe" and wait:
            values:
                id: 96
                name: "fraction"
                age: 1.7
    if last database error is set:
        log "SKRIPTORM_SELFTEST=FAIL sqlite refused a fraction it used to cut: %last database error%"
    in connection "sqlite":
        select one entity from table "orm_sqlite_probe" by id 96 and store the result in {sqlite::numeric::fraction::*}
    if {sqlite::numeric::fraction::age} is not 1:
        log "SKRIPTORM_SELFTEST=FAIL sqlite cut a fraction to '%{sqlite::numeric::fraction::age}%' instead of 1"

    # A read that is refused before it runs clears the variable it would have stored into, the way a read
    # that fails at the database does. Otherwise the previous result is still sitting there and a script
    # cannot tell "the row is gone" from "the statement did not run".
    in connection "sqlite":
        select one entity from table "orm_sqlite_probe" by id 4 and store the result in {sqlite::refused::*}
    if {sqlite::refused::id} is not 4:
        log "SKRIPTORM_SELFTEST=FAIL sqlite refused-read setup read '%{sqlite::refused::id}%' instead of 4"
    in connection "sqlite":
        select one entity from table "orm_no_such_table" by id 4 and store the result in {sqlite::refused::*}
    if {sqlite::refused::id} is set:
        log "SKRIPTORM_SELFTEST=FAIL sqlite a refused read left '%{sqlite::refused::id}%' in the result variable"

    # The same rule for the colon-free spelling, which refuses through its own path.
    in connection "sqlite":
        select entity from table "orm_sqlite_probe" by id 4 and store the result in {sqlite::refused::effect::*}
    if {sqlite::refused::effect::id} is not 4:
        log "SKRIPTORM_SELFTEST=FAIL sqlite refused-read setup (colon-free) read '%{sqlite::refused::effect::id}%' instead of 4"
    in connection "sqlite":
        select entity from table "orm_no_such_table" by id 4 and store the result in {sqlite::refused::effect::*}
    if {sqlite::refused::effect::id} is set:
        log "SKRIPTORM_SELFTEST=FAIL sqlite a refused colon-free read left '%{sqlite::refused::effect::id}%' behind"

    # What the reads actually returned. Rows come back keyed by a one-based row index first, so a
    # `select many` is read as `{sqlite::many::1::name}` even when it matched one row.
    set {sqlite::failed} to false

    if {sqlite::by-id::id} is not 1:
        set {sqlite::failed} to true
        log "SKRIPTORM_SELFTEST=FAIL sqlite select by id read id '%{sqlite::by-id::id}%'"
    if {sqlite::by-id::name} is not "Alice":
        set {sqlite::failed} to true
        log "SKRIPTORM_SELFTEST=FAIL sqlite select by id read name '%{sqlite::by-id::name}%'"
    if {sqlite::by-id::age} is not 30:
        set {sqlite::failed} to true
        log "SKRIPTORM_SELFTEST=FAIL sqlite select by id read age '%{sqlite::by-id::age}%'"
    if {sqlite::many::1::name} is not "Alice":
        set {sqlite::failed} to true
        log "SKRIPTORM_SELFTEST=FAIL sqlite select many read first row '%{sqlite::many::1::name}%'"
    if {sqlite::many::2::name} is not "Bob":
        set {sqlite::failed} to true
        log "SKRIPTORM_SELFTEST=FAIL sqlite select many read second row '%{sqlite::many::2::name}%'"
    if {sqlite::page::1::id} is not 2:
        set {sqlite::failed} to true
        log "SKRIPTORM_SELFTEST=FAIL sqlite page two read id '%{sqlite::page::1::id}%'"
    if {sqlite::updated::name} is not "Carol":
        set {sqlite::failed} to true
        log "SKRIPTORM_SELFTEST=FAIL sqlite update read back '%{sqlite::updated::name}%'"
    if {sqlite::left::1::name} is not "Alice":
        set {sqlite::failed} to true
        log "SKRIPTORM_SELFTEST=FAIL sqlite delete left '%{sqlite::left::1::name}%'"
    if {sqlite::left::2::id} is set:
        set {sqlite::failed} to true
        log "SKRIPTORM_SELFTEST=FAIL sqlite delete left a second row"

    if {sqlite::failed} is true:
        log "SKRIPTORM_SELFTEST detail: sqlite round trip -> failed"
    else:
        log "SKRIPTORM_SELFTEST detail: sqlite round trip -> ok"

    set {skriptorm::selftest::done::sqlite} to true

# Checks how Skript counts and loops over a result stored as `{rows::index::column}`.
# Skript treats each row as a nested list without a scalar value, so `size of {rows::*}` and
# `loop {rows::*}` both yield zero even when individual row keys are present. The test checks
# the same shape built directly in Skript, a copied result, and both ordinary and fast storage.
#
# Skript 2.16.2 also rejects `loop 1 to 20`. This test uses supported count and list loops to
# walk row indices and verifies that a flat list loops normally.
#
# Each result is checked by index as well, so an empty `size of` result cannot hide missing rows.

on load:
    set {skriptorm::selftest::started::result-size} to true

    wait 6 seconds

    create a connection named "size" to database "JDBC" with properties:
        driver: "org.sqlite.JDBC"
        url: "jdbc:sqlite:plugins/Skript/size-probe.db?synchronous=OFF&journal_mode=MEMORY"
    if last database error is set:
        log "SKRIPTORM_SELFTEST=FAIL result size connect: %last database error%"

    in connection "size":
        register a database table "orm_size_probe":
            id: bigint, primary key, not null
            name: string(64), nullable
    if last database error is set:
        log "SKRIPTORM_SELFTEST=FAIL result size register table: %last database error%"

    # 5000 rows of two columns: 10 000 values, which is where the plugin's fast attach path starts, so the
    # last control below goes through it while the small ones do not.
    loop 5000 times:
        set {rs::seed::%loop-number%::id} to loop-number
        set {rs::seed::%loop-number%::name} to "row"
    in connection "size":
        insert many {rs::seed::*} into table "orm_size_probe" and wait
    if last database error is set:
        log "SKRIPTORM_SELFTEST=FAIL result size seed: %last database error%"

    # A small result, stored the ordinary way: 20 rows of two columns.
    in connection "size":
        select many entities from table "orm_size_probe" and store the results in {rs::small::*}:
            where all:
                id <= 20
    if last database error is set:
        log "SKRIPTORM_SELFTEST=FAIL result size small read: %last database error%"

    # The same read into a local variable, since the fast path refuses locals and the ordinary path does not.
    in connection "size":
        select many entities from table "orm_size_probe" and store the results in {_local::*}:
            where all:
                id <= 20

    # The controls the plugin cannot influence: a flat list, and a list built with the plugin's own
    # two-level shape — a row index, then a column name under it.
    loop 20 times:
        set {_built::%loop-number%} to loop-number
        set {_mirror::%loop-number%::id} to loop-number
        set {_mirror::%loop-number%::name} to "row"

    # Confirm that ordinary flat lists still report their size and support iteration.
    set {_flatLooped} to 0
    loop {_built::*}:
        add 1 to {_flatLooped}

    # Compare with the same nested shape built directly in Skript.
    set {_mirrorLooped} to 0
    loop {_mirror::*}:
        add 1 to {_mirrorLooped}

    # Iterate a result stored by the addon.
    set {_readLooped} to 0
    loop {rs::small::*}:
        add 1 to {_readLooped}

    # Walk the row indices with a supported count loop.
    set {_walked} to 0
    loop 20 times:
        if {rs::small::%loop-number%::id} is set:
            add 1 to {_walked}

    # Check direct row access independently of loop behavior.
    set {_directly} to 0
    if {rs::small::1::id} is set:
        add 1 to {_directly}
    if {rs::small::20::id} is set:
        add 1 to {_directly}

    # Form one: a count loop. `loop-number` is the iteration count.
    set {_timesRan} to 0
    set {_timesHits} to 0
    set {_timesFirst} to -1
    set {_timesLast} to -1
    loop 20 times:
        add 1 to {_timesRan}
        if {_timesFirst} is -1:
            set {_timesFirst} to loop-number
        set {_timesLast} to loop-number
        if {rs::small::%loop-number%::id} is set:
            add 1 to {_timesHits}

    # Walk an explicit index list with `loop-value`.
    loop 20 times:
        set {_indices::%loop-number%} to loop-number
    set {_listRan} to 0
    set {_listHits} to 0
    set {_listValue} to -1
    loop {_indices::*}:
        add 1 to {_listRan}
        set {_listValue} to loop-value
        if {rs::small::%loop-value%::id} is set:
            add 1 to {_listHits}

    # Check whether copying the result changes Skript's list behavior.
    set {_copy::*} to {rs::small::*}

    # A result big enough for the fast attach path: 5000 rows of two columns, exactly 10 000 values.
    in connection "size":
        select page 1 with size 5000 from table "orm_size_probe" and store the results in {rs::big::*}
    if last database error is set:
        log "SKRIPTORM_SELFTEST=FAIL result size big read: %last database error%"

    # The first large read probes the fast path. Replace it again with a mixed-case target so the
    # existing tree path, persisted names, and newly published names all use Skript's same casing.
    set {RS::BIG::old} to "stale"
    set {RS::BIG::nested} to "parent"
    set {RS::BIG::nested::child} to "stale"
    set {RS::BIG::1::id} to -1
    set {RS::BIG} to "keep"
    in connection "size":
        select page 1 with size 5000 from table "orm_size_probe" and store the results in {RS::BIG::*}
    if last database error is set:
        log "SKRIPTORM_SELFTEST=FAIL result size second big read: %last database error%"
    if {rs::big::old} is set:
        log "SKRIPTORM_SELFTEST=FAIL result size: fast replacement kept an old leaf"
    if {rs::big::nested} is set:
        log "SKRIPTORM_SELFTEST=FAIL result size: fast replacement kept an old nested scalar"
    if {rs::big::nested::child} is set:
        log "SKRIPTORM_SELFTEST=FAIL result size: fast replacement kept an old nested leaf"
    if {rs::big} is not "keep":
        log "SKRIPTORM_SELFTEST=FAIL result size: fast replacement lost the list's scalar"
    if {rs::big::1::id} is not 1:
        log "SKRIPTORM_SELFTEST=FAIL result size: fast replacement did not update the first row"

    # A short literal list is another supported loop form.
    set {_literalRan} to 0
    # Include `and` to avoid Skript's warning about an incomplete list.
    loop 1, 2, and 3:
        add 1 to {_literalRan}

    if size of {_built::*} is not 20:
        log "SKRIPTORM_SELFTEST=FAIL result size: a flat list the script built reported %size of {_built::*}%, not 20"
    if {_flatLooped} is not 20:
        log "SKRIPTORM_SELFTEST=FAIL result size: looping a flat list the script built ran %{_flatLooped}% times, not 20"
    if {_walked} is not 20:
        log "SKRIPTORM_SELFTEST=FAIL result size: walking the stored result's indices counted %{_walked}% rows, not 20"
    if {rs::small::1::id} is not 1:
        log "SKRIPTORM_SELFTEST=FAIL result size: the stored result's first row is %{rs::small::1::id}%, not 1"
    if {rs::small::20::id} is not 20:
        log "SKRIPTORM_SELFTEST=FAIL result size: the stored result's last row is %{rs::small::20::id}%, not 20"
    if {rs::big::5000::id} is not 5000:
        log "SKRIPTORM_SELFTEST=FAIL result size: the fast path's last row is %{rs::big::5000::id}%, not 5000"
    if size of {_mirror::*} is not 0:
        log "SKRIPTORM_SELFTEST=FAIL result size: the same shape built by the script reported %size of {_mirror::*}% instead of 0"
    if {_mirrorLooped} is not 0:
        log "SKRIPTORM_SELFTEST=FAIL result size: looping the same shape built by the script ran %{_mirrorLooped}% times instead of 0"
    if size of {rs::small::*} is not 0:
        log "SKRIPTORM_SELFTEST=FAIL result size: the stored result reported %size of {rs::small::*}% instead of 0"
    if {_readLooped} is not 0:
        log "SKRIPTORM_SELFTEST=FAIL result size: looping the stored result ran %{_readLooped}% times instead of 0"
    if size of {_local::*} is not 0:
        log "SKRIPTORM_SELFTEST=FAIL result size: a local result reported %size of {_local::*}% instead of 0"
    if size of {_copy::*} is not 0:
        log "SKRIPTORM_SELFTEST=FAIL result size: a copy of the result reported %size of {_copy::*}% instead of 0"
    if size of {rs::big::*} is not 0:
        log "SKRIPTORM_SELFTEST=FAIL result size: the fast path's result reported %size of {rs::big::*}% instead of 0"
    # Assert direct access and each loop form separately to identify which behavior changed.
    if {_directly} is not 2:
        log "SKRIPTORM_SELFTEST=FAIL result size: the rows were readable at %{_directly}% of their 2 own indices, so the loop forms below are not what is being measured"
    if {_timesRan} is not 20:
        log "SKRIPTORM_SELFTEST=FAIL result size: a count loop ran its body %{_timesRan}% times, not 20"
    if {_timesHits} is not 20:
        log "SKRIPTORM_SELFTEST=FAIL result size: a count loop found %{_timesHits}% of the stored rows, not 20"
    if {_timesFirst} is not 1:
        log "SKRIPTORM_SELFTEST=FAIL result size: a count loop's first loop-number was %{_timesFirst}%, not 1"
    if {_timesLast} is not 20:
        log "SKRIPTORM_SELFTEST=FAIL result size: a count loop's last loop-number was %{_timesLast}%, not 20"
    if {_listRan} is not 20:
        log "SKRIPTORM_SELFTEST=FAIL result size: a list loop ran its body %{_listRan}% times, not 20"
    if {_listHits} is not 20:
        log "SKRIPTORM_SELFTEST=FAIL result size: a list loop found %{_listHits}% of the stored rows, not 20"
    if {_listValue} is not 20:
        log "SKRIPTORM_SELFTEST=FAIL result size: a list loop's last loop-value was %{_listValue}%, not 20"
    if {_literalRan} is not 3:
        log "SKRIPTORM_SELFTEST=FAIL result size: looping three literal values ran %{_literalRan}% times, not 3"

    log "SKRIPTORM_SELFTEST detail: result size -> built=%size of {_built::*}% flatLooped=%{_flatLooped}% mirror=%size of {_mirror::*}% mirrorLooped=%{_mirrorLooped}% read=%size of {rs::small::*}% readLooped=%{_readLooped}% walked=%{_walked}% local=%size of {_local::*}% copy=%size of {_copy::*}% fast=%size of {rs::big::*}% firstId=%{rs::small::1::id}% lastId=%{rs::small::20::id}% fastLastId=%{rs::big::5000::id}% directly=%{_directly}% timesRan=%{_timesRan}% timesHits=%{_timesHits}% timesFirst=%{_timesFirst}% timesLast=%{_timesLast}% listRan=%{_listRan}% listHits=%{_listHits}% listValue=%{_listValue}% literalRan=%{_literalRan}%"

    set {skriptorm::selftest::done::result-size} to true

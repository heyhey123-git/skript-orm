# select by id
#
# One element per file, so a failure is named by the file it happened in. The marker at the end
# is both the run-once guard and what `99-finish.sk` waits for: it is set once the element has
# reported, because a section or effect may delay its own detail line. `prepareServerTest` clears
# Skript's variable store before every run, so a marker cannot survive from an earlier one.
every 5 seconds:
    if {skriptorm::selftest::done::select-by-id} is set:
        stop trigger

    # This one keeps its colon on purpose: it is now the only place a read is written as a section
    # with no body, so the colon spelling stays covered by the suite.
    select one entity from table "orm_selftest" by id 1 and store the result in {_by_id::*}:
    log "SKRIPTORM_SELFTEST detail: select by id -> %last database error%"
    set {skriptorm::selftest::done::select-by-id} to true

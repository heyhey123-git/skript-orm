# select by id, without a colon
#
# One element per file, so a failure is named by the file it happened in. The marker at the end is both
# the run-once guard and what `99-finish.sk` waits for.
#
# This form never had a body to give: the row is named by its primary key and a `where` is refused. The
# section spelling stays in `10-select-by-id.sk`, so both spellings keep their coverage, and this one costs
# no empty-section warning.
every 5 seconds:
    if {xiaojie::selftest::done::select-by-id-unfiltered} is set:
        stop trigger

    select entity from table "orm_selftest" by id 1 and store the result in {_by_id::*}
    log "XIAOJIE_SELFTEST detail: select by id unfiltered -> %last database error%"
    set {xiaojie::selftest::done::select-by-id-unfiltered} to true

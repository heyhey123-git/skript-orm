# Transactions, against the real connection `00-setup.sk` made.
#
# Four things are checked here, and each of them is a rule the syntax promises:
#
#   1. a body that reaches its end commits;
#   2. a statement that fails makes the rest of the body do nothing, and the whole body is rolled back;
#   3. `rollback database transaction` undoes the body and leaves the section;
#   4. a body that stays open past its timeout is rolled back on its own.
#
# The rows are read back with one `select many` whose output is logged: `row1` is the committed row and
# `row2` is `<none>` exactly when nothing else survived. One line of evidence for both a commit and a
# rollback, which is also what the harness compares against.
#
# `elements/16-disconnect` waits for this script before it closes the default connection, because the
# reads here need it.
every 5 seconds:
    if {xiaojie::selftest::done::transaction} is set:
        stop trigger
    if {xiaojie::selftest::started::transaction} is set:
        stop trigger
    if {xiaojie::selftest::done::setup} is not set:
        stop trigger
    set {xiaojie::selftest::started::transaction} to true

    register a database table "orm_transaction":
        id: bigint, primary key, auto increment, not null
        label: string(32), nullable

    # 1. Reaching the end of the body commits it.
    database transaction:
        insert one entity into table "orm_transaction" and wait:
            values:
                label: "committed"
    log "XIAOJIE_SELFTEST detail: transaction commit -> %last database error%"

    # 2. The read names a table that does not exist, so it fails inside the body. The insert after it
    #    must not run, and the insert before it must not survive.
    database transaction:
        insert one entity into table "orm_transaction" and wait:
            values:
                label: "must not survive"
        select one entity from table "orm_transaction_missing" and store the result in {_tx::missing::*}
        insert one entity into table "orm_transaction" and wait:
            values:
                label: "after the failure"
    log "XIAOJIE_SELFTEST detail: transaction failed -> %last database error%"

    select many entities from table "orm_transaction" and store the results in {_tx::rows::*}
    log "XIAOJIE_SELFTEST detail: transaction rows -> row1=%{_tx::rows::1::label}% row2=%{_tx::rows::2::label}%"

    # 3. An explicit rollback undoes the body and leaves the section, so the insert after it never runs.
    database transaction:
        insert one entity into table "orm_transaction" and wait:
            values:
                label: "rolled back by the script"
        rollback database transaction
        insert one entity into table "orm_transaction" and wait:
            values:
                label: "after the rollback"
    log "XIAOJIE_SELFTEST detail: transaction rollback -> %last database error%"

    select many entities from table "orm_transaction" and store the results in {_tx::rows::*}
    log "XIAOJIE_SELFTEST detail: transaction rollback rows -> row1=%{_tx::rows::1::label}% row2=%{_tx::rows::2::label}%"

    # 4. The timeout is what keeps a script that stops mid-transaction from holding a connection: the
    #    wait below outlives it, and the transaction is rolled back while the trigger is parked.
    database transaction with timeout 2 seconds:
        insert one entity into table "orm_transaction" and wait:
            values:
                label: "abandoned"
        wait 5 seconds
        insert one entity into table "orm_transaction" and wait:
            values:
                label: "after the timeout"
    log "XIAOJIE_SELFTEST detail: transaction timeout -> %last database error%"

    select many entities from table "orm_transaction" and store the results in {_tx::rows::*}
    log "XIAOJIE_SELFTEST detail: transaction timeout rows -> row1=%{_tx::rows::1::label}% row2=%{_tx::rows::2::label}%"

    # A statement inside a transaction waits on its own, and a table cannot be registered in one.
    database transaction:
        register a database table "orm_transaction_refused":
            id: bigint, primary key, auto increment, not null
    log "XIAOJIE_SELFTEST detail: transaction refuse -> %last database error%"

    set {xiaojie::selftest::done::transaction} to true

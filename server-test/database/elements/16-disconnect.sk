# disconnect, in database mode
#
# This file replaces the element of the same name. `prepareServerTest` copies `server-test/database/`
# over `server-test/skript/`, so it lands where that element would have, and the run keeps the same
# number of scripts.
#
# It exists because of when it would otherwise run. Every script here fires every five seconds, and
# the round trip holds the one shared connection across a five second wait, so an element that
# disconnected as soon as it fired would pull the database out from under it: the insert and the reads
# would report "No database connected." rather than what they are meant to tell apart, which is
# exactly what a write that stored nothing would look like. Waiting for the round trip to record
# itself keeps this element's own check, that a live connection can be closed, without racing it.
# The connection element is waited for as well: it reads the default connection's table registry
# while its named connection is open, and it would see the same missing-database message if this
# element closed the default connection first. The transaction element is waited for for the same
# reason, and because its own timeout test parks the trigger for five seconds at a time.
#
# Offline there is no shared connection to protect, so the element runs on its own schedule there.
every 5 seconds:
    if {skriptorm::selftest::done::disconnect} is set:
        stop trigger
    if {skriptorm::selftest::done::roundtrip} is not set:
        stop trigger
    if {skriptorm::selftest::done::connections} is not set:
        stop trigger
    if {skriptorm::selftest::done::transaction} is not set:
        stop trigger

    disconnect from the current database
    log "SKRIPTORM_SELFTEST detail: disconnect -> ran"

    # The all-form is driven here too, because this is the last script that needs a connection: every
    # other one that reads the database has recorded itself by now. The connection it closes is this
    # element's own, so the form is checked with something alive to close rather than as a no-op.
    create a connection named "closing" to database "MySQL" with properties:
        url: "__URL__"
        username: "__USERNAME__"
        password: "__PASSWORD__"
    disconnect from all connections
    log "SKRIPTORM_SELFTEST detail: disconnect all -> ran"

    set {skriptorm::selftest::done::disconnect} to true
